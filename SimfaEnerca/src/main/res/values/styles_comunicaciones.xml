<?xml version="1.0" encoding="utf-8"?>
<!-- Estilos de la pantalla de Comunicaciones (paleta para el sol de colors_lectura). -->
<resources>

    <!-- Tarjeta que agrupa acciones. -->
    <style name="ComTarjeta">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:background">@drawable/bg_lec_tarjeta</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">12dp</item>
    </style>

    <!-- Titulo de la tarjeta. -->
    <style name="ComTituloSeccion">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/lec_texto</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Texto de apoyo (gris oscuro, nunca gris claro). -->
    <style name="ComDescripcion">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textColor">@color/lec_texto2</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Boton lleno (Enviar datos / Descargar mi ruta). -->
    <style name="ComBotonLleno">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:background">@drawable/bg_com_primario</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:drawableTint">@color/com_texto_lleno</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/com_texto_lleno</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Tarjeta de accion: icono + titulo en negrita + una linea de descripcion (texto con estilo). -->
    <style name="ComBotonAccion">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/bg_com_accion</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:drawableTint">@color/com_icono_accion</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:lineSpacingExtra">1dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/com_texto_accion</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Etiqueta encima de un campo de la carga antigua. -->
    <style name="ComEtiquetaCampo">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/lec_texto</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Campo de la carga antigua (ciclo, municipio, seccion, division). -->
    <style name="ComCampo">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:background">@drawable/bg_lec_campo</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textColor">@color/com_texto_campo</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
