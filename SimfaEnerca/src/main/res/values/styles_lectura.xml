<?xml version="1.0" encoding="utf-8"?>
<!-- Estilos de la pantalla de lectura v2 (activity_menu_de_liquidacion). -->
<resources xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Tecla del teclado: toda la tecla responde (las teclas reciben el click en MenuDeLiquidacion). -->
    <style name="TeclaLectura">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardBackgroundColor">@color/lec_tecla</item>
    </style>

    <style name="TeclaLecturaTexto">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/lec_tecla_texto</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <!-- Flechas de navegacion: tonales, solo icono. -->
    <style name="BotonNavLectura">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:layout_marginEnd">2dp</item>
        <item name="android:background">@drawable/bg_lec_tonal</item>
        <item name="android:scaleType">center</item>
        <item name="android:tint">@color/lec_tecla_texto</item>
    </style>

    <!-- Causal, Buscar, Foto, Luz: con contorno, icono en el color primario. -->
    <style name="BotonAccionLectura" parent="BotonNavLectura">
        <item name="android:background">@drawable/bg_lec_accion</item>
        <item name="android:tint">@color/lec_primario</item>
    </style>
</resources>
