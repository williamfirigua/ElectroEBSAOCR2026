<?xml version="1.0" encoding="utf-8"?>
<!-- Estilos de la pantalla de lectura v2 (activity_menu_de_liquidacion). -->
<resources xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Tecla del teclado: toda la tecla responde (las teclas reciben el click en MenuDeLiquidacion). -->
    <style name="TeclaLectura">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardBackgroundColor">@color/lec_tecla</item>
    </style>

    <style name="TeclaLecturaTexto">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/lec_texto</item>
        <item name="android:textSize">26sp</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <!-- Causal, Foto, Buscar, Luz: boton con contorno, icono y texto. -->
    <style name="BotonAccionLectura">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_lec_contorno</item>
        <item name="android:drawablePadding">2dp</item>
        <item name="android:drawableTint">@color/lec_primario</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/lec_primario</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
