<?xml version="1.0" encoding="utf-8"?>
<!-- Dialogos de causal, subcausal, informe, busqueda y galeria con la paleta de sol de la lectura v2
     (colors_lectura.xml): fondo blanco, texto negro, bordes oscuros de 2dp y botones de 44dp. -->
<resources>

    <!-- Tema de los AlertDialog de AppCompat: new AlertDialog.Builder(activity, R.style.CauDialogo). -->
    <style name="CauDialogo" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="colorPrimary">@color/lec_primario</item>
        <item name="colorAccent">@color/lec_primario</item>
        <item name="colorControlNormal">@color/lec_contorno</item>
        <item name="colorControlActivated">@color/lec_primario</item>
        <item name="android:windowBackground">@drawable/bg_cau_dialogo</item>
        <item name="android:textColorPrimary">@color/lec_texto</item>
        <item name="android:textColorSecondary">@color/lec_texto2</item>
        <item name="android:textColorHint">@color/lec_texto2</item>
        <item name="android:windowTitleStyle">@style/CauDialogo.Titulo</item>
        <item name="buttonBarPositiveButtonStyle">@style/CauDialogo.BotonPrimario</item>
        <item name="buttonBarNegativeButtonStyle">@style/CauDialogo.BotonContorno</item>
        <item name="buttonBarNeutralButtonStyle">@style/CauDialogo.BotonContorno</item>
        <item name="alertDialogStyle">@style/CauDialogo.Alerta</item>
    </style>

    <!-- Filas de setItems (subcausales) de 48dp, en negrita. -->
    <style name="CauDialogo.Alerta" parent="AlertDialog.AppCompat">
        <item name="listItemLayout">@layout/item_cau_subcausal</item>
    </style>

    <style name="CauDialogo.Titulo" parent="RtlOverlay.DialogWindowTitle.AppCompat">
        <item name="android:textAppearance">@style/CauDialogo.TituloTexto</item>
    </style>

    <style name="CauDialogo.TituloTexto" parent="TextAppearance.AppCompat.Title">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/lec_texto</item>
    </style>

    <style name="CauDialogo.BotonPrimario" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:background">@drawable/bg_cau_boton_primario</item>
        <item name="android:textColor">@color/cau_boton_primario_texto</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">88dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="CauDialogo.BotonContorno" parent="CauDialogo.BotonPrimario">
        <item name="android:background">@drawable/bg_cau_boton_contorno</item>
        <item name="android:textColor">@color/lec_primario</item>
    </style>

    <!--
      Dialogos de la lectura en hoja (DialogosLectura.builder): suben desde abajo, a todo el ancho, al alcance del
      pulgar; titulo mas grande y botones de 60dp uno debajo del otro, el principal arriba. Solo presentacion.
    -->
    <style name="CauDialogo.Hoja">
        <item name="android:windowBackground">@drawable/bg_dlg_hoja</item>
        <item name="android:windowAnimationStyle">@style/CauDialogo.Hoja.Animacion</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowMinWidthMinor">100%</item>
        <item name="android:windowTitleStyle">@style/CauDialogo.Hoja.Titulo</item>
        <item name="dialogPreferredPadding">20dp</item>
        <item name="alertDialogCenterButtons">false</item>
        <item name="buttonBarPositiveButtonStyle">@style/CauDialogo.Hoja.BotonPrimario</item>
        <item name="buttonBarNegativeButtonStyle">@style/CauDialogo.Hoja.BotonContorno</item>
        <item name="buttonBarNeutralButtonStyle">@style/CauDialogo.Hoja.BotonContorno</item>
        <item name="alertDialogStyle">@style/CauDialogo.Hoja.Alerta</item>
    </style>

    <style name="CauDialogo.Hoja.Alerta" parent="CauDialogo.Alerta">
        <item name="android:layout">@layout/dlg_alerta_hoja</item>
    </style>

    <style name="CauDialogo.Hoja.Animacion">
        <item name="android:windowEnterAnimation">@anim/dlg_hoja_entra</item>
        <item name="android:windowExitAnimation">@anim/dlg_hoja_sale</item>
    </style>

    <style name="CauDialogo.Hoja.Titulo" parent="CauDialogo.Titulo">
        <item name="android:textAppearance">@style/CauDialogo.Hoja.TituloTexto</item>
    </style>

    <style name="CauDialogo.Hoja.TituloTexto" parent="CauDialogo.TituloTexto">
        <item name="android:textSize">21sp</item>
    </style>

    <style name="CauDialogo.Hoja.BotonPrimario" parent="CauDialogo.BotonPrimario">
        <item name="android:background">@drawable/bg_dlg_hoja_primario</item>
        <item name="android:textSize">19sp</item>
        <item name="android:minHeight">60dp</item>
        <item name="android:layout_marginStart">0dp</item>
        <item name="android:layout_marginTop">10dp</item>
    </style>

    <style name="CauDialogo.Hoja.BotonContorno" parent="CauDialogo.Hoja.BotonPrimario">
        <item name="android:background">@drawable/bg_dlg_hoja_contorno</item>
        <item name="android:textColor">@color/lec_texto</item>
        <item name="android:textSize">17sp</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <!-- Campos de busqueda: blanco con borde negro (bg_lec_campo), texto de 16sp en negrita. -->
    <style name="CauCampo">
        <item name="android:background">@drawable/bg_lec_campo</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textColor">@color/lec_texto</item>
        <item name="android:textColorHint">@color/lec_texto2</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:drawableTint">@color/lec_texto</item>
    </style>

    <!-- Criterio de busqueda (RadioButton sin circulo). -->
    <style name="BusChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/bg_bus_chip</item>
        <item name="android:button">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textColor">@color/bus_chip_texto</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
