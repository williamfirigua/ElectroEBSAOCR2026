<?xml version="1.0" encoding="utf-8"?>
<!-- Estilos de las pantallas de sistema: Diagnostico (FechayHora), Conexion al servidor (Configurar_webIp),
     Licencia (ActLicencia), Pendientes de envio (ModuloConsultaNoEnviados) y Cargando (loading_activity).
     Paleta para el sol de colors_lectura. -->
<resources>

    <!-- Casilla de estado del diagnostico: ToggleButton deshabilitado que solo indica (no se toca). -->
    <style name="SisEstado">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:clickable">false</item>
        <item name="android:focusable">false</item>
        <item name="android:enabled">false</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingTop">24dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/lec_texto</item>
        <item name="android:textOff">Revisando…</item>
        <item name="android:textOn">…</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Nombre de la casilla (GPS, Modo avion...), encima del valor; deja libre el punto de la izquierda. -->
    <style name="SisEstadoEtiqueta">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">top|start</item>
        <item name="android:layout_marginStart">32dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:textColor">@color/lec_texto2</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Boton secundario de 48dp: blanco con borde primario. -->
    <style name="SisBotonContorno">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:background">@drawable/sis_bg_boton_contorno</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:drawableTint">@color/sis_texto_contorno</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/sis_texto_contorno</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Segmento de un control segmentado hecho con CheckBox sin cuadro (la exclusion la hace el Java). -->
    <style name="SisSegmento">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:button">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:textColor">@color/bus_chip_texto</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Campo de configuracion de 48dp con borde de 2dp; bloqueado, gris. -->
    <style name="SisCampo">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:background">@drawable/sis_bg_campo</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">@color/com_texto_campo</item>
        <item name="android:textColorHint">@color/lec_texto2</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Contador del resumen de pendientes (Pendientes / Rechazadas / Archivos). -->
    <style name="SisContador">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_lec_tarjeta</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <style name="SisContadorEtiqueta">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/lec_texto2</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="SisContadorValor">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/lec_texto</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Resultado en linea (Probar conexion, errores de licencia). -->
    <style name="SisResultado">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/sis_bg_resultado_neutro</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:lineSpacingExtra">1dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textColor">@color/lec_texto</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
