<?xml version="1.0" encoding="utf-8"?>
<!--
  Acceso (GuiAcceso), paleta para el sol de la lectura v2: fondo blanco, texto negro, bordes de 2dp.
    - detras, abajo, la ilustracion de la red de distribucion (acc_fondo_red) sobre un degradado muy claro
    - arriba los dos logos (GS&S y EBSA) con la fecha y la hora
    - codigo, clave e Ingresar
    - Comunicaciones, Impresora y Acerca de siempre a la vista; Bluetooth, Bateria, Carga y Salir debajo
    - abajo, la cinta azul oscura con la ruta cargada (txtCondicion, se desplaza sola)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_acc_fondo"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp">

            <!-- Logos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="Global Solutions &amp; Service S.A.S."
                    android:scaleType="fitCenter"
                    android:src="@drawable/acc_logo_gss" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="EBSA, Empresa de Energía de Boyacá"
                    android:scaleType="fitCenter"
                    android:src="@drawable/acc_logo_ebsa" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtFecha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFeatureSettings="tnum"
                android:text=""
                android:textColor="@color/lec_texto2"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtAcceso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Facturación en sitio"
                android:textColor="@color/lec_texto"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Ingrese con su código o su usuario de la web."
                android:textColor="@color/lec_texto2"
                android:textSize="14sp" />

            <!-- Codigo y clave -->
            <TextView
                style="@style/AccRotulo"
                android:labelFor="@+id/txtUsername"
                android:text="Código o usuario" />

            <EditText
                android:id="@+id/txtUsername"
                style="@style/AccCampo"
                android:hint="Su código"
                android:importantForAutofill="no"
                android:inputType="textNoSuggestions"
                android:maxLength="30">

                <requestFocus />
            </EditText>

            <TextView
                style="@style/AccRotulo"
                android:labelFor="@+id/txtPassword"
                android:text="Clave" />

            <EditText
                android:id="@+id/txtPassword"
                style="@style/AccCampo"
                android:hint="Su clave"
                android:importantForAutofill="no"
                android:inputType="numberPassword"
                android:maxLength="11" />

            <!-- Nombre del aforador que encontro el codigo, o el error -->
            <TextView
                android:id="@+id/txtNombreUsuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/lec_primario"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- GuiAcceso le pone el tinte: gris oscuro mientras no se puede ingresar, azul cuando si. -->
            <Button
                android:id="@+id/btnIngresar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_acc_boton_primario"
                android:stateListAnimator="@null"
                android:text="Ingresar"
                android:textAllCaps="false"
                android:textColor="@color/lec_banner_texto"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Siempre a la vista: Comunicaciones, Impresora, Acerca de -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-4dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="-4dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnComunicar2"
                    style="@style/AccBotonPrincipal"
                    android:drawableTop="@drawable/ic_acc_comunicaciones"
                    android:text="Comunicaciones" />

                <Button
                    android:id="@+id/btnImprime"
                    style="@style/AccBotonPrincipal"
                    android:visibility="gone"
                    android:drawableTop="@drawable/ic_acc_impresora"
                    android:text="Impresora" />

                <Button
                    android:id="@+id/btnAcercaDe"
                    style="@style/AccBotonPrincipal"
                    android:drawableTop="@drawable/ic_acc_info"
                    android:text="Acerca de" />
            </LinearLayout>

            <!-- Estado de la impresora (GuiAcceso escribe aqui la MAC o el estado) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Impresora: "
                    android:textColor="@color/lec_texto2"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtRemoteDevice"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/lec_texto"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Bluetooth, Bateria, Carga y Salir -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-4dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="-4dp"
                android:orientation="horizontal">

                <LinearLayout style="@style/AccColumnaSecundaria">

                    <ImageButton
                        android:id="@+id/btnBluetooth"
                        style="@style/AccBotonSecundario"
                        android:contentDescription="Buscar impresora por Bluetooth"
                        android:src="@drawable/ic_nav_bluetooth"
                        android:tooltipText="Buscar impresora por Bluetooth" />

                    <TextView
                        style="@style/AccEtiquetaSecundaria"
                        android:text="Bluetooth" />
                </LinearLayout>

                <LinearLayout style="@style/AccColumnaSecundaria">

                    <ImageButton
                        android:id="@+id/btnBateria"
                        style="@style/AccBotonSecundario"
                        android:contentDescription="Estado de la batería"
                        android:src="@drawable/ic_acc_bateria"
                        android:tooltipText="Estado de la batería" />

                    <TextView
                        style="@style/AccEtiquetaSecundaria"
                        android:text="Batería" />
                </LinearLayout>

                <LinearLayout style="@style/AccColumnaSecundaria">

                    <!-- Sin tinte: el icono es verde con ruta cargada y rojo sin ella (lo cambia GuiAcceso). -->
                    <ImageButton
                        android:id="@+id/btnInfo"
                        style="@style/AccBotonSecundarioBase"
                        android:contentDescription="Ruta cargada en el equipo"
                        android:src="@drawable/ic_acc_carga_ok"
                        android:tooltipText="Ruta cargada en el equipo" />

                    <TextView
                        android:id="@+id/txtInfocarga"
                        style="@style/AccEtiquetaSecundaria"
                        android:text="Carga" />
                </LinearLayout>

                <LinearLayout style="@style/AccColumnaSecundaria">

                    <ImageButton
                        android:id="@+id/btnSalir"
                        style="@style/AccBotonSecundario"
                        android:background="@drawable/bg_acc_salir"
                        android:contentDescription="Salir de la aplicación"
                        android:src="@drawable/ic_nav_exit"
                        android:tint="@color/lec_error"
                        android:tooltipText="Salir de la aplicación" />

                    <TextView
                        style="@style/AccEtiquetaSecundaria"
                        android:text="Salir"
                        android:textColor="@color/lec_error" />
                </LinearLayout>
            </LinearLayout>

            <!-- Foto del usuario: GuiAcceso la carga, no se muestra en el acceso. -->
            <ImageView
                android:id="@+id/fotoUsuario"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:contentDescription="@string/foto_usuario"
                android:src="@drawable/avatar_man_icono"
                android:visibility="gone" />

            <!--
              Espacio libre de abajo: lleva la red de distribucion (decorativa) y la version encima. Ocupa solo lo
              que sobra, asi que con el teclado abierto el dibujo se recorta y nunca queda detras de los campos.
            -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginStart="-16dp"
                android:layout_marginEnd="-16dp"
                android:layout_marginBottom="-8dp"
                android:layout_weight="1"
                android:minHeight="40dp">

            <!-- La red pegada abajo; usa solo el alto que sobra (se recorta por arriba si no cabe). -->
            <com.gselectroCaqueta.accesoyseguridad.FondoRed
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Version y equipo -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_acc_pie"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp">

                <TextView
                    android:id="@+id/txtVerion"
                    style="@style/AccPie"
                    android:text="Versión" />

                <TextView
                    style="@style/AccPie"
                    android:text="  ·  Equipo " />

                <TextView
                    android:id="@+id/txtCodInterno"
                    style="@style/AccPie"
                    android:maxLength="15"
                    android:text="" />
            </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Cinta con la ruta cargada: se desplaza sola (GuiAcceso la deja seleccionada). -->
    <TextView
        android:id="@+id/txtCondicion"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@color/lec_banner"
        android:ellipsize="marquee"
        android:fontFeatureSettings="tnum"
        android:gravity="center_vertical"
        android:marqueeRepeatLimit="marquee_forever"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:scrollHorizontally="true"
        android:singleLine="true"
        android:text="Sin ruta cargada en el equipo"
        android:textColor="@color/lec_banner_texto"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>
