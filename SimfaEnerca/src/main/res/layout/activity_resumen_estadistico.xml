<?xml version="1.0" encoding="utf-8"?>
<!--
  Resumen de la ruta (paleta para el sol, como la pantalla de lectura v2), compacto para el Armor 22.
  Todo cuenta REGISTROS (registradores): casillas, avance, filtros y lista. Arriba: encabezado, aviso,
  casillas, avance, filtros y buscador; debajo la lista (maximo 10 registros). La estadistica completa
  se abre en un dialogo con el boton de grafica.
  Abajo: continuar la liquidacion (abre en el primer cliente pendiente) o ir a la cuenta seleccionada.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lec_superficie"
    android:orientation="vertical">

    <!-- Encabezado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/lec_superficie"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/btnVolver"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_lec_icono"
            android:contentDescription="Volver"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_nav_back"
            android:tint="@color/lec_texto" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Resumen de la ruta"
                android:textColor="@color/lec_texto"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtNombreRuta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFeatureSettings="tnum"
                android:singleLine="true"
                android:text="Cargando…"
                android:textColor="@color/lec_texto2"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnDetalle"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_lec_accion"
            android:contentDescription="Ver la estadística de la ruta"
            android:enabled="false"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_nav_bar_chart"
            android:tint="@color/lec_primario" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/lec_contorno" />

    <!-- Aviso: fecha descuadrada, ruta terminada, error de lectura -->
    <TextView
        android:id="@+id/txtAviso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_lec_aviso"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:textColor="@color/lec_aviso_texto"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Indicadores (registros) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="7dp"
        android:paddingTop="6dp"
        android:paddingEnd="7dp">

        <LinearLayout
            style="@style/ResIndicador"
            android:backgroundTint="@color/lec_tecla">

            <TextView
                android:id="@+id/txtTotal"
                style="@style/ResIndicadorNumero" />

            <TextView
                style="@style/ResIndicadorEtiqueta"
                android:text="Registros" />
        </LinearLayout>

        <LinearLayout
            style="@style/ResIndicador"
            android:backgroundTint="@color/lec_exito">

            <TextView
                android:id="@+id/txtLeidos"
                style="@style/ResIndicadorNumero" />

            <TextView
                style="@style/ResIndicadorEtiqueta"
                android:text="Leídos" />
        </LinearLayout>

        <LinearLayout
            style="@style/ResIndicador"
            android:backgroundTint="@color/lec_primario">

            <TextView
                android:id="@+id/txtPendientes"
                style="@style/ResIndicadorNumero" />

            <TextView
                style="@style/ResIndicadorEtiqueta"
                android:text="Pendientes" />
        </LinearLayout>

        <LinearLayout
            style="@style/ResIndicador"
            android:backgroundTint="@color/lec_banner_nuevo">

            <TextView
                android:id="@+id/txtAnomalias"
                style="@style/ResIndicadorNumero"
                android:textColor="@color/lec_banner_nuevo_texto" />

            <TextView
                style="@style/ResIndicadorEtiqueta"
                android:text="Anomalías"
                android:textColor="@color/lec_banner_nuevo_texto" />
        </LinearLayout>
    </LinearLayout>

    <!-- Avance -->
    <ProgressBar
        android:id="@+id/barAvance"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="10dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/bg_res_avance" />

    <TextView
        android:id="@+id/txtAvance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum"
        android:paddingStart="12dp"
        android:paddingTop="2dp"
        android:paddingEnd="12dp"
        android:textColor="@color/lec_texto"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Filtros (cuentan registros) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:scrollbars="none">

        <RadioGroup
            android:id="@+id/GrupoOpciones"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/OptTodas"
                style="@style/ResChip"
                android:checked="true"
                android:text="Todas" />

            <RadioButton
                android:id="@+id/OptProcesadas"
                style="@style/ResChip"
                android:text="Procesadas" />

            <RadioButton
                android:id="@+id/OptNoprocesada"
                style="@style/ResChip"
                android:text="Pendientes" />

            <RadioButton
                android:id="@+id/OptAnomalias"
                style="@style/ResChip"
                android:text="Anomalías" />
        </RadioGroup>
    </HorizontalScrollView>

    <!-- Solo con Anomalías: limitar a una causa -->
    <Spinner
        android:id="@+id/spCausa"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="10dp"
        android:visibility="gone" />

    <EditText
        android:id="@+id/txtBuscar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_lec_campo"
        android:drawableStart="@drawable/ic_lec_buscar"
        android:drawablePadding="8dp"
        android:drawableTint="@color/lec_texto2"
        android:fontFeatureSettings="tnum"
        android:hint="Buscar cuenta o medidor"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="@color/lec_texto"
        android:textColorHint="@color/lec_borde"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtConteoLista"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:textColor="@color/lec_texto2"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Lista vacía o sin coincidencias -->
    <TextView
        android:id="@+id/txtVacio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp"
        android:textColor="@color/lec_texto"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Hasta 10 registros (MAX_FILAS en ResumenEstadistico). -->
        <ListView
            android:id="@+id/listaRegistros"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:choiceMode="singleChoice"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="6dp"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp" />

        <ProgressBar
            android:id="@+id/progresoCarga"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/lec_primario" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/lec_contorno" />

    <!-- Acciones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/lec_superficie"
        android:orientation="horizontal"
        android:padding="8dp">

        <Button
            android:id="@+id/btnLiquidarSeleccion"
            style="@style/ResBoton"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_res_secundario"
            android:enabled="false"
            android:text="Ir a la cuenta"
            android:textColor="@color/lec_primario" />

        <Button
            android:id="@+id/btnCerrar"
            style="@style/ResBoton"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_res_primario"
            android:enabled="false"
            android:text="Continuar ▶"
            android:textColor="@color/lec_tecla_texto" />
    </LinearLayout>

</LinearLayout>
