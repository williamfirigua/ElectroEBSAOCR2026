<?xml version="1.0" encoding="utf-8"?>
<!--
  Cargando (dialogo de progreso de MenuDeLiquidacion.mensajeAdm): tarjeta blanca con borde oscuro, spinner,
  titulo (txt_loadAct, lo pone MenuDeLiquidacion: "Validando registros no enviados", "Liquidacion automatica")
  y "Espere por favor". La ventana del dialogo es transparente (lo hace el Java).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="340dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        app:cardBackgroundColor="@color/lec_superficie"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/lec_contorno"
        app:strokeWidth="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="20dp">

            <ProgressBar
                android:id="@+id/progressBar_cyclic"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/lec_primario" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txt_loadAct"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="Validando registros no enviados"
                    android:textColor="@color/lec_texto"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Espere por favor"
                    android:textColor="@color/lec_texto2"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
