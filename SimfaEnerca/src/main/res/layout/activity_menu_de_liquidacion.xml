<?xml version="1.0" encoding="utf-8"?>
<!--
  Pantalla de lectura (v2, Material 3 de alto contraste). De arriba abajo:
    barra superior: ruta; mensajes, codigo de barras de la factura y menu lateral
    franja de estado: red, critica de la lectura (texto), envio en curso e impresora
    tarjeta del cliente: medidor, ACTIVA/REACTIVA, estado especial, direccion, marca, nombre y cuenta,
      y el detalle (tablaResumen) que ocupa el espacio que queda y se desplaza. El aviso de desviacion
      sale encima del final del detalle: no tapa la cabecera del cliente ni mueve los botones.
    navegacion (primero / anterior / siguiente / ultimo) y al lado Causal, Buscar, Foto y Luz
    lectura con el registro y el sentido de la ruta al lado; debajo GPS y distancia al predio (discreto)
    teclado (Borrar: un digito, sostenido limpia; OK liquida e imprime)
  El lector no ve lectura anterior, promedio ni consumos. Todos los ids que usa MenuDeLiquidacion se conservan.
-->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/panelLecturas1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/lec_superficie"
        android:orientation="vertical">

        <!-- Barra superior -->
        <LinearLayout
            android:id="@+id/tabla_fondo"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@color/lec_superficie"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/txtTituloLectura"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="20sp"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeTextType="uniform"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:text="Lectura"
                android:textColor="@color/lec_texto"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp">

                <ImageView
                    android:id="@+id/imagenChat"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_lec_icono"
                    android:clickable="true"
                    android:contentDescription="Mensajes de la oficina"
                    android:focusable="true"
                    android:padding="10dp"
                    android:scaleType="fitCenter" />

                <!-- Mensajes de la oficina sin leer (BandejaMensajes) -->
                <TextView
                    android:id="@+id/txtMensajesNoLeidos"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_badge_mensajes"
                    android:gravity="center"
                    android:minWidth="18dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Leer el codigo de barras de la factura (cupon de pago) para ir a esa cuenta. -->
            <ImageButton
                android:id="@+id/btnBarras"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_lec_icono"
                android:contentDescription="Leer el código de barras de la factura"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_barcode"
                android:tint="@color/lec_texto" />

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_lec_icono"
                android:contentDescription="Menú"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_menu"
                android:tint="@color/lec_texto" />
        </LinearLayout>

        <!-- Franja de estado: red, tipo de cuenta, critica de la lectura, envio en curso e impresora -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:background="@color/lec_contenedor"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <ImageView
                android:id="@+id/imagenRed"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/red_inactiva" />

            <!-- Antes imagenes; ahora la critica va en texto (txtCritica) y el estado especial en lblInfoMedida. -->
            <ImageView android:id="@+id/imagenLiquid_1" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <ImageView android:id="@+id/imagenLiquid_2" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <ImageView android:id="@+id/imagenLiquid_3" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

            <!-- Critica de la lectura: Consumo alto, Consumo bajo, Menor a la anterior, Igual a la anterior -->
            <TextView
                android:id="@+id/txtCritica"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:singleLine="true"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Envio en curso -->
            <ProgressBar
                android:id="@+id/progressEnvio"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="10dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/lec_primario"
                android:visibility="invisible" />

            <ImageButton
                android:id="@+id/imagenPrinter"
                android:layout_width="40dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_lec_icono"
                android:contentDescription="Impresora"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_print"
                android:tint="@color/lec_error" />
        </LinearLayout>

        <!-- Tarjeta del cliente con su detalle desplazable -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_lec_tarjeta"
            android:orientation="vertical"
            android:padding="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtMedidorCuenta"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFeatureSettings="tnum"
                        android:singleLine="true"
                        android:textColor="@color/lec_texto"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtTipoMedida"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_chip_activa"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="3dp"
                        android:singleLine="true"
                        android:textColor="#FFFFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- POSTAL, PROVISIONAL, INTEGRA., TESTIGO, CORTADO (el color lo pone la liquidacion) -->
                    <TextView
                        android:id="@+id/lblInfoMedida"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_lec_chip_info"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="3dp"
                        android:singleLine="true"
                        android:text=""
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtCabDireccion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/lec_texto"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtCabMarca"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textColor="@color/lec_texto2"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtCabNombre"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="@color/lec_texto2"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/txtCabCuenta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFeatureSettings="tnum"
                        android:singleLine="true"
                        android:textColor="@color/lec_texto2"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/lblpuntero"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/lec_divisor" />

            <!-- Detalle del cliente: ocupa el espacio que queda y se desplaza -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <ScrollView
                    android:id="@+id/scroll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true"
                    android:scrollbars="vertical">

                    <TableLayout
                        android:id="@+id/tablaResumen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </ScrollView>

                <!-- Aviso de desviacion: flota sobre el final del detalle, se va solo o al tocarlo. -->
                <TextView
                    android:id="@+id/txtAvisoDesviacion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_margin="8dp"
                    android:drawablePadding="12dp"
                    android:elevation="6dp"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="12dp"
                    android:textSize="15sp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- Contenedor en curso: visible solo entre "Iniciar contenedor" y "Cerrar". -->
        <TextView
            android:id="@+id/txtContenedor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_contenedor"
            android:gravity="center"
            android:padding="6dp"
            android:textColor="@color/lec_aviso_texto"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Navegacion y, al lado, Causal, Buscar, Foto y Luz (sostener un boton muestra su nombre) -->
        <LinearLayout
            android:id="@+id/tableButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp">

            <ImageButton
                android:id="@+id/btnPrimero"
                style="@style/BotonNavLectura"
                android:contentDescription="@string/primer_registro"
                android:src="@drawable/ic_lec_primero"
                android:tooltipText="Primer registro" />

            <ImageButton
                android:id="@+id/btnAtras"
                style="@style/BotonNavLectura"
                android:contentDescription="@string/atras_un_registro"
                android:src="@drawable/ic_lec_anterior"
                android:tooltipText="Anterior" />

            <ImageButton
                android:id="@+id/btnAdelante"
                style="@style/BotonNavLectura"
                android:contentDescription="@string/adelanta_un_registro"
                android:src="@drawable/ic_lec_siguiente"
                android:tooltipText="Siguiente" />

            <ImageButton
                android:id="@+id/btnUltimo"
                style="@style/BotonNavLectura"
                android:contentDescription="@string/ultimo_registro"
                android:src="@drawable/ic_lec_ultimo"
                android:tooltipText="Ultimo registro" />

            <View
                android:layout_width="6dp"
                android:layout_height="1dp" />

            <ImageButton
                android:id="@+id/btnAnomalia"
                style="@style/BotonAccionLectura"
                android:contentDescription="Causal"
                android:src="@drawable/ic_lec_causal"
                android:tooltipText="Causal" />

            <ImageButton
                android:id="@+id/btnBuscar"
                style="@style/BotonAccionLectura"
                android:contentDescription="Buscar cliente"
                android:src="@drawable/ic_lec_buscar"
                android:tooltipText="Buscar cliente" />

            <ImageButton
                android:id="@+id/btnTomarFoto"
                style="@style/BotonAccionLectura"
                android:contentDescription="Tomar foto"
                android:src="@drawable/ic_lec_foto"
                android:tooltipText="Foto" />

            <ImageButton
                android:id="@+id/btnLinterna"
                style="@style/BotonAccionLectura"
                android:contentDescription="Encender linterna"
                android:src="@drawable/ic_lec_luz"
                android:tooltipText="Luz (o sacuda el celular dos veces)" />
        </LinearLayout>

        <!-- Lectura y, al lado, el registro y el sentido de la ruta -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:background="@drawable/bg_lec_campo"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:labelFor="@+id/txtElectura"
                    android:text="Lectura"
                    android:textColor="@color/lec_primario"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/txtElectura"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:fontFeatureSettings="tnum"
                    android:gravity="end|center_vertical"
                    android:hint="—"
                    android:importantForAutofill="no"
                    android:inputType="none"
                    android:letterSpacing="0.06"
                    android:maxLength="13"
                    android:textColor="@color/lec_texto"
                    android:textColorHint="@color/lec_borde"
                    android:textSize="30sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- "16 / 3531" y "→ adelante" / "← atrás" -->
            <TextView
                android:id="@+id/txtSentidoRuta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFeatureSettings="tnum"
                android:gravity="end"
                android:maxLines="2"
                android:minWidth="64dp"
                android:textColor="@color/lec_texto"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- GPS y distancia al predio: una linea discreta -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginEnd="4dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_lec_ubicacion"
                android:tint="@color/lec_texto2" />

            <TextView
                android:id="@+id/txtLatitud"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:maxLength="14"
                android:singleLine="true"
                android:text="0.00"
                android:textColor="@color/lec_texto2"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=", "
                android:textColor="@color/lec_texto2"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txtLongitud"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFeatureSettings="tnum"
                android:maxLength="14"
                android:singleLine="true"
                android:text="0.00"
                android:textColor="@color/lec_texto2"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txtDistancia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:maxLength="20"
                android:singleLine="true"
                android:text="Sin GPS"
                android:textColor="@color/lec_texto2"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Teclado: Borrar quita un digito (sostenido limpia); OK liquida e imprime -->
        <GridLayout
            android:id="@+id/gridTeclado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            android:columnCount="3"
            android:rowCount="4">

            <com.google.android.material.card.MaterialCardView android:id="@+id/Boton1" style="@style/TeclaLectura">
                <TextView style="@style/TeclaLecturaTexto" android:text="1" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:id="@+id/Boton2" style="@style/TeclaLectura">
                <TextView style="@style/TeclaLecturaTexto" android:text="2" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:id="@+id/Boton3" style="@style/TeclaLectura">
                <TextView style="@style/TeclaLecturaTexto" android:text="3" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:id="@+id/Boton4" style="@style/TeclaLectura">
                <TextView style="@style/TeclaLecturaTexto" android:text="4" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:id="@+id/Boton5" style="@style/TeclaLectura">
                <TextView style="@style/TeclaLecturaTexto" android:text="5" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:id="@+id/Boton6" style="@style/TeclaLectura">
                <TextView style="@style/TeclaLecturaTexto" android:text="6" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:id="@+id/Boton7" style="@style/TeclaLectura">
                <TextView style="@style/TeclaLecturaTexto" android:text="7" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:id="@+id/Boton8" style="@style/TeclaLectura">
                <TextView style="@style/TeclaLecturaTexto" android:text="8" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:id="@+id/Boton9" style="@style/TeclaLectura">
                <TextView style="@style/TeclaLecturaTexto" android:text="9" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:id="@+id/BotonDel" style="@style/TeclaLectura">
                <!-- Toda la tecla es el boton (antes solo el icono de 34dp). -->
                <ImageView
                    android:id="@+id/delete"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackground"
                    android:contentDescription="Borrar un dígito; sostenido limpia la lectura"
                    android:paddingBottom="12dp"
                    android:scaleType="center"
                    android:src="@drawable/ic_lec_borrar" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="3dp"
                    android:importantForAccessibility="no"
                    android:text="sostener: limpiar"
                    android:textColor="@color/lec_texto2"
                    android:textSize="10sp" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:id="@+id/Boton0" style="@style/TeclaLectura">
                <TextView style="@style/TeclaLecturaTexto" android:text="0" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/BotonOk"
                style="@style/TeclaLectura"
                app:cardBackgroundColor="@color/lec_primario">

                <TextView
                    android:id="@+id/Btn_ok"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackground"
                    android:contentDescription="OK: liquidar e imprimir"
                    android:gravity="center"
                    android:text="OK"
                    android:textColor="#FFFFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>
        </GridLayout>
    </LinearLayout>

    <!-- Menu lateral: abre desde la derecha -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="290dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/lec_superficie"
        app:itemBackground="@drawable/bg_menu_item_nav"
        app:itemIconTint="@color/lec_primario"
        app:itemTextColor="@color/lec_texto"
        app:menu="@menu/menu_lateral_liquidacion" />
</androidx.drawerlayout.widget.DrawerLayout>
