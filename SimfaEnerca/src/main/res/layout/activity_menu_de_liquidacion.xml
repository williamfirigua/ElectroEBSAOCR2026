<?xml version="1.0" encoding="utf-8"?>
<!--
  Pantalla de liquidacion. Estructura:
    barra de estado (iconos + impresora + menu lateral)
    tarjeta del cliente (cuenta, nombre, direccion, medidor)  -> lo que el lector necesita de un vistazo
    detalle del cliente (tablaResumen) que ocupa el espacio restante y se desplaza
    navegacion/acciones, lectura, GPS y teclado
  Todos los ids que usa MenuDeLiquidacion se conservan. El Spinner "MENU..." se reemplazo por el
  menu lateral (nav_view). Ya no hay alturas fijas: el detalle toma el espacio con layout_weight.
-->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/panelLecturas1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFF5F6FA"
        android:orientation="vertical">

        <!-- Barra de estado -->
        <LinearLayout
            android:id="@+id/tabla_fondo"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@color/ocrePop"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="2dp">

            <ImageView
                android:id="@+id/imagenRed"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="4dp"
                android:contentDescription="@string/red_inactiva" />

            <ImageView
                android:id="@+id/imagenChat"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="4dp"
                android:clickable="true"
                android:contentDescription="Mensajes"
                android:focusable="true"
                android:scaleType="fitCenter" />

            <ImageView
                android:id="@+id/imagenLiquid_3"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="2dp"
                android:contentDescription="@string/red_inactiva" />

            <ImageView
                android:id="@+id/imagenLiquid_2"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="2dp"
                android:contentDescription="@string/red_inactiva" />

            <ImageView
                android:id="@+id/imagenLiquid_1"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="@string/red_inactiva" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Indicador de envio en curso (como en Lecturas). -->
            <ProgressBar
                android:id="@+id/progressEnvio"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:indeterminate="true"
                android:indeterminateTint="@android:color/white"
                android:visibility="invisible" />

            <ImageButton
                android:id="@+id/imagenPrinter"
                android:layout_width="52dp"
                android:layout_height="42dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Impresora"
                android:padding="0dp"
                android:scaleType="fitCenter"
                android:src="@drawable/impresora_ko" />

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Menú"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_menu" />
        </LinearLayout>

        <!-- Tarjeta del cliente. Orden segun lo que el lector busca en la calle: medidor y tipo de medida,
             direccion y marca. Cuenta y nombre van pequenos al pie. Alto contraste para uso bajo el sol. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_tarjeta_cliente"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtMedidorCuenta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:singleLine="true"
                    android:textColor="#FF000000"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtTipoMedida"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_activa"
                    android:paddingStart="10dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp"
                    android:singleLine="true"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtCabDireccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#FF000000"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtCabMarca"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="#FF1A1A1A"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtCabNombre"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="#FF424242"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtCabCuenta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:singleLine="true"
                    android:textColor="#FF424242"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/lblpuntero"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:singleLine="true"
                    android:text="0"
                    android:textColor="#FF424242"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Detalle del cliente: ocupa el espacio que queda y se desplaza -->
        <ScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="6dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tarjeta_cliente"
            android:fillViewport="true"
            android:padding="1dp"
            android:scrollbars="vertical">

            <TableLayout
                android:id="@+id/tablaResumen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </ScrollView>

        <!-- Navegacion y acciones rapidas -->
        <LinearLayout
            android:id="@+id/tableButtons"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <ImageButton
                android:id="@+id/btnPrimero"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/primer_registro"
                android:padding="2dp"
                android:scaleType="fitCenter"
                android:src="@drawable/atras1" />
            <ImageButton
                android:id="@+id/btnAtras"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/atras_un_registro"
                android:padding="2dp"
                android:scaleType="fitCenter"
                android:src="@drawable/flprimero" />
            <ImageButton
                android:id="@+id/btnAdelante"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/adelanta_un_registro"
                android:padding="2dp"
                android:scaleType="fitCenter"
                android:src="@drawable/adelante1" />
            <ImageButton
                android:id="@+id/btnUltimo"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/ultimo_registro"
                android:padding="2dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ultimo1" />
            <ImageButton
                android:id="@+id/btnAnomalia"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Capturar anomalía"
                android:padding="2dp"
                android:scaleType="fitCenter"
                android:src="@drawable/anomalia" />
            <ImageButton
                android:id="@+id/btnBuscar"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Buscar cliente"
                android:padding="2dp"
                android:scaleType="fitCenter"
                android:src="@drawable/buscar" />
            <ImageButton
                android:id="@+id/btnTomarFoto"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Tomar foto"
                android:padding="2dp"
                android:scaleType="fitCenter"
                android:src="@drawable/camara" />
        </LinearLayout>

        <!-- Lectura -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <EditText
                android:id="@+id/txtElectura"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:gravity="start|center_vertical"
                android:hint="LECTURA"
                android:importantForAutofill="no"
                android:inputType="none"
                android:maxLength="13"
                android:textSize="26sp"
                android:textStyle="bold" />

            <!-- Sentido de la ruta y estado especial de la cuenta (POSTAL, PROVISIONAL, CORTADO...).
                 ACTIVA/REACTIVA ya se ve en la tarjeta, por eso aqui va el sentido de la ruta. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtSentidoRuta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:singleLine="true"
                    android:textColor="#FF000000"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/lblInfoMedida"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text=""
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- GPS: una sola linea discreta -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/grayBlueSoft"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/txtLatitud"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLength="14"
                android:singleLine="true"
                android:text="0.00"
                android:textColor="@color/bluePopSoft"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txtLongitud"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLength="14"
                android:singleLine="true"
                android:text="0.00"
                android:textColor="@color/bluePopSoft"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txtDistancia"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:maxLength="12"
                android:singleLine="true"
                android:text="0"
                android:textColor="@color/bluePopSoft"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Teclado numerico adaptativo -->
        <GridLayout
            android:id="@+id/gridTeclado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:rowCount="4"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_marginBottom="2dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/Boton1"
                android:layout_width="0dp"
                android:layout_height="@dimen/tecla_alto"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                app:cardElevation="10dp"
                app:cardCornerRadius="10dp"
                app:cardBackgroundColor="@color/grayblack">
                <TextView android:layout_width="match_parent" android:layout_height="match_parent"
                    android:textColor="@color/white" android:text="1" android:textSize="20sp" android:gravity="center"/>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/Boton2"
                android:layout_width="0dp"
                android:layout_height="@dimen/tecla_alto"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                app:cardElevation="10dp"
                app:cardCornerRadius="10dp"
                app:cardBackgroundColor="@color/grayblack">
                <TextView android:layout_width="match_parent" android:layout_height="match_parent"
                    android:textColor="@color/white" android:text="2" android:textSize="20sp" android:gravity="center"/>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/Boton3"
                android:layout_width="0dp"
                android:layout_height="@dimen/tecla_alto"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                app:cardElevation="10dp"
                app:cardCornerRadius="10dp"
                app:cardBackgroundColor="@color/grayblack">
                <TextView android:layout_width="match_parent" android:layout_height="match_parent"
                    android:textColor="@color/white" android:text="3" android:textSize="20sp" android:gravity="center"/>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/Boton4"
                android:layout_width="0dp"
                android:layout_height="@dimen/tecla_alto"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                app:cardElevation="10dp"
                app:cardCornerRadius="10dp"
                app:cardBackgroundColor="@color/grayblack">
                <TextView android:layout_width="match_parent" android:layout_height="match_parent"
                    android:textColor="@color/white" android:text="4" android:textSize="20sp" android:gravity="center"/>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/Boton5"
                android:layout_width="0dp"
                android:layout_height="@dimen/tecla_alto"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                app:cardElevation="10dp"
                app:cardCornerRadius="10dp"
                app:cardBackgroundColor="@color/grayblack">
                <TextView android:layout_width="match_parent" android:layout_height="match_parent"
                    android:textColor="@color/white" android:text="5" android:textSize="20sp" android:gravity="center"/>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/Boton6"
                android:layout_width="0dp"
                android:layout_height="@dimen/tecla_alto"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                app:cardElevation="10dp"
                app:cardCornerRadius="10dp"
                app:cardBackgroundColor="@color/grayblack">
                <TextView android:layout_width="match_parent" android:layout_height="match_parent"
                    android:textColor="@color/white" android:text="6" android:textSize="20sp" android:gravity="center"/>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/Boton7"
                android:layout_width="0dp"
                android:layout_height="@dimen/tecla_alto"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                app:cardElevation="10dp"
                app:cardCornerRadius="10dp"
                app:cardBackgroundColor="@color/grayblack">
                <TextView android:layout_width="match_parent" android:layout_height="match_parent"
                    android:textColor="@color/white" android:text="7" android:textSize="20sp" android:gravity="center"/>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/Boton8"
                android:layout_width="0dp"
                android:layout_height="@dimen/tecla_alto"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                app:cardElevation="10dp"
                app:cardCornerRadius="10dp"
                app:cardBackgroundColor="@color/grayblack">
                <TextView android:layout_width="match_parent" android:layout_height="match_parent"
                    android:textColor="@color/white" android:text="8" android:textSize="20sp" android:gravity="center"/>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/Boton9"
                android:layout_width="0dp"
                android:layout_height="@dimen/tecla_alto"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                app:cardElevation="10dp"
                app:cardCornerRadius="10dp"
                app:cardBackgroundColor="@color/grayblack">
                <TextView android:layout_width="match_parent" android:layout_height="match_parent"
                    android:textColor="@color/white" android:text="9" android:textSize="20sp" android:gravity="center"/>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/BotonDel"
                android:layout_width="0dp"
                android:layout_height="@dimen/tecla_alto"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                app:cardElevation="10dp"
                app:cardCornerRadius="10dp"
                app:cardBackgroundColor="@color/grayblack">
                <ImageView
                    android:id="@+id/delete"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:src="@drawable/delete"
                    android:layout_gravity="center"/>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/Boton0"
                android:layout_width="0dp"
                android:layout_height="@dimen/tecla_alto"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                app:cardElevation="10dp"
                app:cardCornerRadius="10dp"
                app:cardBackgroundColor="@color/grayblack">
                <TextView android:layout_width="match_parent" android:layout_height="match_parent"
                    android:textColor="@color/white" android:text="0" android:textSize="20sp" android:gravity="center"/>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/BotonOk"
                android:layout_width="0dp"
                android:layout_height="@dimen/tecla_alto"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                app:cardElevation="10dp"
                app:cardCornerRadius="10dp"
                app:cardBackgroundColor="@color/grayblack">
                <TextView
                    android:id="@+id/Btn_ok"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:textColor="@color/white"
                    android:text="OK"
                    android:textSize="25sp"
                    android:gravity="center"/>
            </com.google.android.material.card.MaterialCardView>

        </GridLayout>
    </LinearLayout>

    <!-- Menu lateral (como en Lecturas): abre desde la derecha -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="290dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#FFF5F6FA"
        app:itemBackground="@drawable/bg_menu_item_nav"
        app:itemIconTint="@color/ocrePop"
        app:itemTextColor="@color/bluePopHard"
        app:menu="@menu/menu_lateral_liquidacion" />
</androidx.drawerlayout.widget.DrawerLayout>
