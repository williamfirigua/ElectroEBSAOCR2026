<?xml version="1.0" encoding="utf-8"?>
<!--
  Formato de impresion (ModuloConfigFormatoImpresion) con la paleta de sol de la lectura v2.
  Ids conservados: chkbxcigap, btnciguardar, txtcicorrer, txtcitemperatura, chkbxdosbarras, chkbxdosImpre,
  chkbxzq521, chkbxrw420 (los dos modelos siguen siendo CheckBox: el Java mantiene la exclusion entre ellos).
  Volver sigue bloqueado ("Debe Guardar y salir"), por eso no hay flecha ni Cancelar.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lec_superficie"
    android:orientation="vertical"
    tools:context="com.gselectroCaqueta.modulocaptnovedlect.ModuloConfigFormatoImpresion">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="12dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_nav_print"
            android:tint="@color/lec_primario" />

        <TextView
            style="@style/lex_Titulo"
            android:text="Formato de impresión" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/lec_divisor" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <TextView
                style="@style/lex_Seccion"
                android:text="Modelo de impresora" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/lex_segmentado"
                android:orientation="horizontal"
                android:padding="2dp">

                <CheckBox
                    android:id="@+id/chkbxzq521"
                    style="@style/lex_Segmento"
                    android:checked="false"
                    android:text="ZQ521" />

                <CheckBox
                    android:id="@+id/chkbxrw420"
                    style="@style/lex_Segmento"
                    android:text="RW420" />
            </LinearLayout>

            <TextView
                style="@style/lex_Seccion"
                android:layout_marginTop="18dp"
                android:text="Ajustes del papel" />

            <TextView
                style="@style/lex_Etiqueta"
                android:labelFor="@id/txtcitemperatura"
                android:text="Temperatura de impresión" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/imp_btnTempMenos"
                    style="@style/lex_Paso"
                    android:contentDescription="Bajar temperatura"
                    android:text="−" />

                <EditText
                    android:id="@+id/txtcitemperatura"
                    style="@style/lex_CampoNumero"
                    android:inputType="numberSigned"
                    android:maxLength="4"
                    android:privateImeOptions="nm"
                    android:text="0" />

                <Button
                    android:id="@+id/imp_btnTempMas"
                    style="@style/lex_Paso"
                    android:contentDescription="Subir temperatura"
                    android:text="+" />
            </LinearLayout>

            <TextView
                style="@style/lex_Ayuda"
                android:text="De -30 a 200. Más alto, letra más oscura." />

            <TextView
                android:id="@+id/imp_txtErrorTemp"
                style="@style/lex_Error" />

            <TextView
                style="@style/lex_Etiqueta"
                android:layout_marginTop="14dp"
                android:labelFor="@id/txtcicorrer"
                android:text="Mover el texto (líneas)" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/imp_btnLineasMenos"
                    style="@style/lex_Paso"
                    android:contentDescription="Mover hacia arriba"
                    android:text="−" />

                <EditText
                    android:id="@+id/txtcicorrer"
                    style="@style/lex_CampoNumero"
                    android:inputType="numberSigned"
                    android:maxLength="3"
                    android:privateImeOptions="nm"
                    android:text="0" />

                <Button
                    android:id="@+id/imp_btnLineasMas"
                    style="@style/lex_Paso"
                    android:contentDescription="Mover hacia abajo"
                    android:text="+" />
            </LinearLayout>

            <TextView
                style="@style/lex_Ayuda"
                android:text="De -200 a 200. Vacío deja 70." />

            <TextView
                android:id="@+id/imp_txtErrorLineas"
                style="@style/lex_Error" />

            <TextView
                style="@style/lex_Seccion"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="0dp"
                android:text="Qué se imprime" />

            <CheckBox
                android:id="@+id/chkbxcigap"
                style="@style/lex_Interruptor"
                android:text="Imprimir gráfico" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-10dp"
                android:paddingBottom="8dp"
                android:text="Gráfico de consumo en la factura"
                android:textColor="@color/lec_texto2"
                android:textSize="13sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/lec_divisor" />

            <CheckBox
                android:id="@+id/chkbxdosbarras"
                style="@style/lex_Interruptor"
                android:text="Dos barras" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-10dp"
                android:paddingBottom="8dp"
                android:text="El gráfico sale con dos barras"
                android:textColor="@color/lec_texto2"
                android:textSize="13sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/lec_divisor" />

            <CheckBox
                android:id="@+id/chkbxdosImpre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Es RW420"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/lec_divisor" />

    <Button
        android:id="@+id/btnciguardar"
        style="@style/lex_BotonPrimario"
        android:layout_width="match_parent"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:text="Guardar formato" />
</LinearLayout>
