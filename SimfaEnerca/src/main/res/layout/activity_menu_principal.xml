<?xml version="1.0" encoding="utf-8"?>
<!--
  Inicio (MenuPrincipal), paleta para el sol de la lectura v2: fondo blanco, texto negro, bordes de 2dp.
    - logos GS&S y EBSA arriba; barra y franja "trabajando" mientras calcula, envia o verifica
    - saludo con la foto del aforador
    - tarjeta azul de la ruta de hoy (toda la tarjeta y "Continuar la ruta" abren la lectura)
    - estado de los envios con su insignia
    - Comunicaciones y Utilidades del equipo
    - Borrar la ruta y Salir al mismo nivel, abajo
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lec_superficie"
    android:orientation="vertical"
    tools:context="com.gselectroCaqueta.accesoyseguridad.MenuPrincipal">

    <!-- Logos -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/btnLogos"
            android:layout_width="wrap_content"
            android:layout_height="58dp"
            android:adjustViewBounds="true"
            android:contentDescription="Global Solutions &amp; Service S.A.S."
            android:scaleType="fitCenter"
            android:src="@drawable/acc_logo_gss" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:adjustViewBounds="true"
            android:contentDescription="EBSA, Empresa de Energía de Boyacá"
            android:scaleType="fitCenter"
            android:src="@drawable/acc_logo_ebsa" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/lec_contorno" />

    <!-- Indicador de trabajo: visible mientras se calcula, se envía o se verifica con el servidor -->
    <ProgressBar
        android:id="@+id/progresoMenu"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/lec_primario"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/txtTrabajando"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_ini_trabajando"
        android:gravity="center"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:textColor="@color/lec_texto"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <!-- Saludo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/fotoAforador"
                    android:layout_width="64dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_lec_tarjeta"
                    android:contentDescription="Foto del aforador"
                    android:padding="2dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/avatar_man_icono" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtTitleMenuPrincipal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Hola,"
                        android:textColor="@color/lec_texto2"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txt_nombre"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="SIN NOMBRE"
                        android:textColor="@color/lec_texto"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtOperador"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/lec_texto2"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtVersion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:textColor="@color/lec_texto2"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Ruta de hoy: toda la tarjeta abre la lectura -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAforador"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/lec_primario"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:id="@+id/txtTitle"
                        style="@style/IniRutaSecundario"
                        android:text="Ruta de hoy" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtRuta"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:text="Sin ruta cargada"
                            android:textColor="@color/lec_banner_texto"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtPrg"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFeatureSettings="tnum"
                            android:singleLine="true"
                            android:text="----"
                            android:textColor="@color/lec_primario_cont"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Avance de la ruta -->
                    <LinearLayout
                        android:id="@+id/panelAvance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/txtAvanceMenu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:textColor="@color/lec_banner_texto"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <ProgressBar
                            android:id="@+id/barAvanceMenu"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="10dp"
                            android:layout_marginTop="10dp"
                            android:max="100"
                            android:progressDrawable="@drawable/bg_ini_progreso" />

                        <TextView
                            android:id="@+id/txtMenuUltima"
                            style="@style/IniRutaSecundario"
                            android:layout_marginTop="8dp"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnIniciarLecturas"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_ini_boton_claro"
                        android:drawableEnd="@drawable/ic_ini_chevron"
                        android:drawableTint="@color/lec_primario"
                        android:paddingStart="48dp"
                        android:paddingEnd="20dp"
                        android:stateListAnimator="@null"
                        android:text="Continuar la ruta"
                        android:textAllCaps="false"
                        android:textColor="@color/lec_primario"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Envíos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_ini_tarjeta"
                android:gravity="center_vertical"
                android:minHeight="72dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="10dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_nav_upload"
                    android:tint="@color/lec_texto" />

                <TextView
                    android:id="@+id/txtEnvios"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="Envíos: consultando…"
                    android:textColor="@color/lec_texto2"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingTop="6dp"
                    android:paddingEnd="6dp">

                    <Button
                        android:id="@+id/btnAyuda"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_lec_tonal"
                        android:minWidth="88dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:stateListAnimator="@null"
                        android:text="Envíos"
                        android:textAllCaps="false"
                        android:textColor="@color/lec_banner_texto"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtInsigniaEnvios"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="-6dp"
                        android:layout_marginEnd="-6dp"
                        android:background="@drawable/bg_ini_insignia"
                        android:elevation="2dp"
                        android:fontFeatureSettings="tnum"
                        android:gravity="center"
                        android:minWidth="26dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:textColor="@color/lec_banner_texto"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>

            <!-- Opciones -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_ini_tarjeta"
                android:orientation="vertical"
                android:padding="2dp">

                <LinearLayout
                    android:id="@+id/btnComunica"
                    style="@style/IniFila"
                    android:contentDescription="@string/menucomunicacion">

                    <ImageView
                        style="@style/IniFilaIcono"
                        android:src="@drawable/ic_nav_sync" />

                    <TextView
                        style="@style/IniFilaTexto"
                        android:text="Comunicaciones" />

                    <ImageView style="@style/IniFilaFlecha" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="@color/lec_divisor" />

                <LinearLayout
                    android:id="@+id/btnUtilidades"
                    style="@style/IniFila"
                    android:contentDescription="@string/utilidades">

                    <ImageView
                        style="@style/IniFilaIcono"
                        android:src="@drawable/ic_nav_build" />

                    <TextView
                        style="@style/IniFilaTexto"
                        android:text="Utilidades del equipo" />

                    <ImageView style="@style/IniFilaFlecha" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Borrar la ruta y Salir, al mismo nivel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <Button
            android:id="@+id/btnElimnarInfo"
            style="@style/IniBotonInferior"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_ini_boton_peligro"
            android:drawableStart="@drawable/ic_ini_borrar"
            android:drawableTint="@color/lec_error"
            android:text="Borrar la ruta"
            android:textColor="@color/lec_error" />

        <Button
            android:id="@+id/btnRetornar"
            style="@style/IniBotonInferior"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_lec_accion"
            android:drawableStart="@drawable/ic_nav_exit"
            android:drawableTint="@color/lec_primario"
            android:text="Salir"
            android:textColor="@color/lec_primario" />
    </LinearLayout>

</LinearLayout>
