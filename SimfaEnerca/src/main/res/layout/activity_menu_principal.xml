<?xml version="1.0" encoding="utf-8"?>
<!--
  Menú principal (diseño de siempre: rejilla 2 x 3 y tarjeta del aforador), con:
    - versión que maneja el equipo (VariablesGlobales.versionApp) en el encabezado
    - barra de progreso bajo el encabezado mientras calcula, envía o verifica con el servidor
    - insignia con los envíos pendientes en el botón Envíos y línea de envíos en la tarjeta
  Desplazable para pantallas bajas.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF5F6FA"
    android:orientation="vertical"
    tools:context="com.gselectroCaqueta.accesoyseguridad.MenuPrincipal">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/ocrePop"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/btnLogos"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:contentDescription="GS&amp;S"
            android:scaleType="fitCenter"
            android:src="@drawable/gss_logo40x40" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtTitleMenuPrincipal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SIM-FA · MENÚ PRINCIPAL"
                android:textColor="#FFFFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Indicador de trabajo: visible mientras se calcula, se envía o se verifica con el servidor -->
    <ProgressBar
        android:id="@+id/progresoMenu"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:indeterminate="true"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/txtTrabajando"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="2dp"
        android:textColor="#FF1565C0"
        android:textSize="12sp"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp">

                <FrameLayout
                    android:layout_width="128dp"
                    android:layout_height="84dp">

                    <ImageButton
                        android:id="@+id/btnIniciarLecturas"
                        android:layout_width="120dp"
                        android:layout_height="75dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_icon_button_selector"
                        android:contentDescription="@string/iniciar_lecturas"
                        android:elevation="4dp"
                        android:padding="10dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/rutero12" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rutero"
                    android:textColor="#FF263238"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp">

                <FrameLayout
                    android:layout_width="128dp"
                    android:layout_height="84dp">

                    <ImageButton
                        android:id="@+id/btnUtilidades"
                        android:layout_width="120dp"
                        android:layout_height="75dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_icon_button_selector"
                        android:contentDescription="@string/utilidades"
                        android:elevation="4dp"
                        android:padding="10dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/utilitario31" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Utilitarios"
                    android:textColor="#FF263238"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp">

                <FrameLayout
                    android:layout_width="128dp"
                    android:layout_height="84dp">

                    <ImageButton
                        android:id="@+id/btnRetornar"
                        android:layout_width="120dp"
                        android:layout_height="75dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_icon_button_selector"
                        android:contentDescription="@string/retornar"
                        android:elevation="4dp"
                        android:padding="10dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/retornar31" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Retornar"
                    android:textColor="#FF263238"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp">

                <FrameLayout
                    android:layout_width="128dp"
                    android:layout_height="84dp">

                    <ImageButton
                        android:id="@+id/btnElimnarInfo"
                        android:layout_width="120dp"
                        android:layout_height="75dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_icon_button_selector"
                        android:contentDescription="@string/eliminar_info"
                        android:elevation="4dp"
                        android:padding="10dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/eliminar23" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Eliminar"
                    android:textColor="#FF263238"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp">

                <FrameLayout
                    android:layout_width="128dp"
                    android:layout_height="84dp">

                    <ImageButton
                        android:id="@+id/btnComunica"
                        android:layout_width="120dp"
                        android:layout_height="75dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_icon_button_selector"
                        android:contentDescription="@string/menucomunicacion"
                        android:elevation="4dp"
                        android:padding="10dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/comunica1" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Comunicaciones"
                    android:textColor="#FF263238"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp">

                <FrameLayout
                    android:layout_width="128dp"
                    android:layout_height="84dp">

                    <ImageButton
                        android:id="@+id/btnAyuda"
                        android:layout_width="120dp"
                        android:layout_height="75dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_icon_button_selector"
                        android:contentDescription="Estado de los envíos"
                        android:elevation="4dp"
                        android:padding="10dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/servidorenlinea" />
                    <TextView
                        android:id="@+id/txtInsigniaEnvios"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:layout_gravity="top|end"
                        android:background="@drawable/bg_insignia"
                        android:gravity="center"
                        android:minWidth="24dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:textColor="#FFFFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Envíos"
                    android:textColor="#FF263238"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAforador"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="4dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="15dp"
                app:cardElevation="5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/txtTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/ocrePop"
                        android:gravity="center"
                        android:padding="2dp"
                        android:text="DATOS DEL AFORADOR"
                        android:textColor="#FFFFFFFF"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/fotoAforador"
                            android:layout_width="96dp"
                            android:layout_height="128dp"
                            android:layout_marginTop="8dp"
                            android:contentDescription="Foto del aforador"
                            android:scaleType="centerCrop"
                            android:src="@drawable/avatar_man_icono" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_marginTop="4dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Nombre completo:"
                        android:textColor="#FF607D8B"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/txt_nombre"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/grayBlue2Soft"
                        android:ellipsize="end"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:singleLine="true"
                        android:text="SIN NOMBRE"
                        android:textColor="#FF263238"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Ruta programada:"
                        android:textColor="#FF607D8B"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/txtRuta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/grayBlue2Soft"
                        android:ellipsize="end"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:singleLine="true"
                        android:text="Sin ruta cargada"
                        android:textColor="#FF263238"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Programa:"
                        android:textColor="#FF607D8B"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/txtPrg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/grayBlue2Soft"
                        android:ellipsize="end"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:singleLine="true"
                        android:text="----"
                        android:textColor="#FF263238"
                        android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txtOperador"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textColor="#FF607D8B"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Avance de la ruta -->
                    <LinearLayout
                        android:id="@+id/panelAvance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <ProgressBar
                            android:id="@+id/barAvanceMenu"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:max="100" />

                        <TextView
                            android:id="@+id/txtAvanceMenu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="#FF263238"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtMenuUltima"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#FF607D8B"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Envíos -->
                    <TextView
                        android:id="@+id/txtEnvios"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="#FFF5F6FA"
                        android:padding="6dp"
                        android:text="Envíos: consultando…"
                        android:textColor="#FF607D8B"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
