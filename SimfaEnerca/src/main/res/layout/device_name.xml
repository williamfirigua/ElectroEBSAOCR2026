<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de impresora (DeviceListActivity): sigue siendo un TextView con "nombre\nMAC" (el Java toma los
     ultimos 17 caracteres como direccion). -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_cau_item"
    android:drawableStart="@drawable/ic_nav_bluetooth"
    android:drawablePadding="12dp"
    android:drawableTint="@color/lec_texto"
    android:fontFeatureSettings="tnum"
    android:gravity="center_vertical"
    android:minHeight="60dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:textColor="@color/lec_texto"
    android:textSize="15sp"
    android:textStyle="bold" />
