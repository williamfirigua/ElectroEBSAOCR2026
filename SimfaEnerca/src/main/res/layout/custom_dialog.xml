<?xml version="1.0" encoding="utf-8"?>
<!--
  Aviso de MenuDeLiquidacion.mensajeAdmCnf (Analitica carta: "Debe entregar carta al usuario").
  Tarjeta blanca con borde oscuro; la franja superior (cardview_dg) toma el color que le pone el Java
  (verde o azul) y lleva el logo y el titulo (tittle_msg). Debajo el mensaje (txtMensaje) y el boton (btnClose).
  La ventana del dialogo es transparente (lo hace el Java).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="340dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        app:cardBackgroundColor="@color/lec_superficie"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/lec_contorno"
        app:strokeWidth="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Franja de color (setBackgroundColor desde el Java). -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardview_dg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/lec_primario_cont"
                app:cardCornerRadius="0dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="64dp"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="10dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/gss_logo40x40"
                        tools:ignore="ContentDescription" />

                    <TextView
                        android:id="@+id/tittle_msg"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:maxLines="2"
                        android:text="Analítica carta"
                        android:textColor="@color/lec_texto"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/txtMensaje"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="20dp"
                android:lineSpacingExtra="2dp"
                android:text="Debe entregar carta al usuario"
                android:textColor="@color/lec_texto"
                android:textSize="18sp"
                tools:ignore="HardcodedText" />

            <Button
                android:id="@+id/btnClose"
                style="@style/ComBotonLleno"
                android:layout_width="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                android:minWidth="120dp"
                android:text="Aceptar"
                tools:ignore="HardcodedText" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
