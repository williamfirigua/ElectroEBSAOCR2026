<?xml version="1.0" encoding="utf-8"?>
<!--
  Busqueda de cliente (ModuloBusquedaCuenta) con la paleta de sol de la lectura v2: fondo blanco, texto negro,
  campo con borde negro, criterio en chips y resultados grandes que se filtran mientras se digita.
  Ids conservados: btnvol, rgBotones, rb*, txtBuscar, txtTipoBusqueda, cabeceraDatos, scroll, tablaResumenDatos.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lec_superficie"
    android:orientation="vertical"
    tools:context="com.gselectroCaqueta.modulobusquedacuenta.ModuloBusquedaCuenta">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">

        <Button
            android:id="@+id/btnvol"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/bg_lec_icono"
            android:contentDescription="Volver a la lectura"
            android:drawableStart="@drawable/ic_nav_back"
            android:drawablePadding="8dp"
            android:drawableTint="@color/lec_texto"
            android:minWidth="48dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:stateListAnimator="@null"
            android:text="Volver"
            android:textAllCaps="false"
            android:textColor="@color/lec_texto"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="Buscar cliente"
            android:textColor="@color/lec_texto"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <EditText
        android:id="@+id/txtBuscar"
        style="@style/CauCampo"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"
        android:drawableStart="@drawable/ic_lec_buscar"
        android:fontFeatureSettings="tnum"
        android:hint="Digite lo que busca"
        android:imeOptions="actionDone"
        android:importantForAutofill="no"
        android:inputType="number"
        android:maxLength="63"
        android:singleLine="true"
        android:textSize="22sp">

        <requestFocus />
    </EditText>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:scrollbars="none">

        <RadioGroup
            android:id="@+id/rgBotones"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbContador"
                style="@style/BusChip"
                android:text="Medidor" />

            <RadioButton
                android:id="@+id/rbCuenta"
                style="@style/BusChip"
                android:text="Cuenta" />

            <RadioButton
                android:id="@+id/rbDireccion"
                style="@style/BusChip"
                android:text="Dirección" />

            <RadioButton
                android:id="@+id/rbNombre"
                style="@style/BusChip"
                android:text="Nombre" />

            <RadioButton
                android:id="@+id/rbRuta"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/ruta"
                android:visibility="gone" />
        </RadioGroup>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/txtTipoBusqueda"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="4dp"
        android:fontFeatureSettings="tnum"
        android:text="Buscando por: Medidor"
        android:textColor="@color/lec_texto2"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TableLayout
        android:id="@+id/cabeceraDatos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/lec_superficie"
        android:fillViewport="true">

        <TableLayout
            android:id="@+id/tablaResumenDatos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </ScrollView>
</LinearLayout>
