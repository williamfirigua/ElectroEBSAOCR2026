<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context="com.gselectroCaqueta.comunicaciones.Comunicaciones">

    <!-- <TableLayout
         android:id="@+id/tabla_cuerpo"
         android:layout_width="match_parent"
         android:layout_height="wrap_content">-->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center">

        <ImageButton
            android:id="@+id/btnLogos"
            android:layout_width="90dp"
            android:layout_height="60dp"
            android:background="@color/zxing_transparent"
            android:contentDescription="@string/info"
            android:scaleType="centerCrop"
            android:src="@drawable/gss_logo40x40" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="0"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/txtTitleComunicaciones"
            android:layout_width="357dp"
            android:layout_height="25dp"
            android:layout_gravity="bottom|right"
            android:layout_weight="1"
            android:background="@color/orangehuila"
            android:gravity="center|bottom"
            android:text="OKINNOM - COMUNICACIONES"
            android:textColor="@color/white"
            android:textSize="17dp"
            android:textStyle="bold">

        </TextView>
        <!-- </TableRow>-->
    </LinearLayout>

    <LinearLayout
        android:layout_width="380dp"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:background="@drawable/bg_card"
        android:elevation="6dp"
        android:orientation="vertical"
        android:padding="10dp"
        android:scrollbarDefaultDelayBeforeFade="420"
        android:scrollbarFadeDuration="250">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/lblCiclo"
                android:layout_width="75dp"
                android:layout_height="20dp"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="5dp"
                android:layout_weight="0"
                android:text="CICLO"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/txtCiclo"
                android:layout_width="130dp"
                android:layout_height="48dp"
                android:layout_gravity="left"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:inputType="number"
                android:maxLength="4"
                android:minHeight="48dp"
                android:padding="8dp"
                android:text="0000" />

            <Button
                android:id="@+id/btnTraerRuta"
                android:layout_width="240dp"
                android:layout_height="48dp"
                android:layout_gravity="right"
                android:layout_weight="7"
                android:background="@drawable/bg_boton_redondeado"
                android:backgroundTint="@color/redPop"
                android:gravity="center"
                android:text="  Traer Ruta   " />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/lblMunicipio"
                android:layout_width="75dp"
                android:layout_height="wrap_content"
                android:layout_columnSpan="1"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="5dp"
                android:layout_weight="0"
                android:text="MUNICIPIO"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/txtMunicipio"
                android:layout_width="130dp"
                android:layout_height="48dp"
                android:layout_gravity="left"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:inputType="number"
                android:maxLength="4"
                android:text="0000" />

            <Button
                android:id="@+id/btnRecibirDatos"
                android:layout_width="240dp"
                android:layout_height="48dp"
                android:layout_gravity="right"
                android:layout_weight="7"
                android:background="@drawable/bg_boton_redondeado"
                android:backgroundTint="@color/bluePop"
                android:gravity="center"
                android:text="Recibir Datos" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/lblSeccion"
                android:layout_width="75dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="5dp"
                android:layout_weight="0"
                android:text="SECCION"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/txtSeccion"
                android:layout_width="130dp"
                android:layout_height="48dp"
                android:layout_gravity="left"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:inputType="number"
                android:maxLength="3"
                android:text="000" />

            <Button
                android:id="@+id/btnEnviarDatos"
                android:layout_width="240dp"
                android:layout_height="48dp"
                android:layout_gravity="right"
                android:layout_weight="7"

                android:background="@drawable/bg_boton_redondeado"
                android:backgroundTint="@color/ocrePop"

                android:gravity="center"
                android:text="Enviar Datos" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/lblDivision"
                android:layout_width="75dp"
                android:layout_height="wrap_content"
                android:layout_columnSpan="1"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="5dp"
                android:layout_weight="0"
                android:text="DIVISION"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/txtDivision"
                android:layout_width="130dp"
                android:layout_height="48dp"
                android:layout_gravity="left"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:inputType="number"
                android:maxLength="1"
                android:text="0" />

            <Button
                android:id="@+id/btnValidaEnvio"
                android:layout_width="240dp"
                android:layout_height="48dp"
                android:layout_gravity="right"
                android:layout_weight="7"
                android:background="@drawable/bg_boton_redondeado"
                android:backgroundTint="@color/greenPop"
                android:gravity="center"
                android:text="Valida Envio " />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/lblArchivo"
                android:layout_width="75dp"
                android:layout_height="wrap_content"
                android:layout_columnSpan="1"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="5dp"
                android:layout_weight="0"
                android:text="Archivo"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lblTxtArchivo"
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:layout_columnSpan="1"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="5dp"
                android:layout_weight="0"
                android:text=" ARCHIVO ." />

            <Button
                android:id="@+id/btnEnviarFotos"
                android:layout_width="240dp"
                android:layout_height="48dp"
                android:layout_gravity="right"
                android:layout_weight="7"
                android:background="@drawable/bg_boton_redondeado"
                android:backgroundTint="@color/purplePop"
                android:enabled="false"
                android:gravity="center"
                android:text="Enviar Fotos" />
        </LinearLayout>

    </LinearLayout>
    <!--</TableLayout>-->

    <!--<TableLayout
        android:id="@+id/tabla_cuerp2o"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="8">-->

    <!--<TableRow
        android:layout_width="match_parent"
        android:layout_height="match_parent">-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center">

        <TextView
            android:id="@+id/txtInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:text=".. .. .... "
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:textSize="16dp" />

        <ImageView
            android:id="@+id/iconwebserviceon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|right"
            android:layout_marginTop="10dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/red_activa"
            android:maxHeight="36dp"
            android:maxWidth="36dp"
            android:scaleType="fitCenter"
            android:src="@mipmap/webserviceon"
            android:visibility="invisible" />

        <ImageView
            android:id="@+id/iconwebserviceoff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|right"
            android:layout_marginTop="10dp"
            android:layout_marginRight="5dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/red_activa"
            android:maxWidth="36dp"
            android:maxHeight="36dp"
            android:scaleType="fitCenter"
            android:src="@mipmap/webserviceoff"
            android:visibility="visible" />

    </LinearLayout>
    <!--</TableRow>-->


    <!--</TableLayout>-->
    <!-- organiza bandeja inferio -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:background="@drawable/bg_card"
            android:elevation="6dp"
            android:orientation="vertical"
            android:padding="10dp"
            android:scrollbarDefaultDelayBeforeFade="400"
            android:scrollbarFadeDuration="250">

            <TableLayout
                android:id="@+id/tabla_cuerpo2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp">

                    <Button
                        android:id="@+id/btnBackupFotos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_weight="1"
                        android:background="@drawable/bg_boton_redondeado"
                        android:backgroundTint="@color/bluePopSoft"
                        android:ellipsize="end"
                        android:enabled="false"
                        android:gravity="center"
                        android:lines="2"
                        android:text=" Backup \nFotos "
                        android:textColor="@color/white"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/btnBorrarBackupFotos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginRight="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_boton_redondeado"
                        android:backgroundTint="@color/purplePopHard"
                        android:ellipsize="end"
                        android:enabled="false"
                        android:gravity="center"
                        android:lines="2"
                        android:text="Borrar Backup\nFotos"
                        android:textColor="@color/white"
                        android:textSize="14sp" />

                </TableRow>

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp">

                    <Button
                        android:id="@+id/btnValidarVersion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_weight="1"
                        android:background="@drawable/bg_boton_redondeado"
                        android:backgroundTint="@color/greenPopHard"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:lines="2"
                        android:text="Validar \nVersion"
                        android:textColor="@color/white"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/btnConfigurarWeb"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginRight="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_boton_redondeado"
                        android:backgroundTint="@color/bluePopHard"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:lines="2"
                        android:text="  Configurar  \n  WebService  "
                        android:textColor="@color/white"
                        android:textSize="14sp" />

                </TableRow>


                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="71dp"
                    android:layout_marginTop="7dp">

                    <Button
                        android:id="@+id/btnRegresar"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginLeft="15dp"
                        android:layout_marginRight="15dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_boton_redondeado"
                        android:backgroundTint="@color/grayPop"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:lines="1"
                        android:text="Regresar" />

                </TableRow>
            </TableLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>


