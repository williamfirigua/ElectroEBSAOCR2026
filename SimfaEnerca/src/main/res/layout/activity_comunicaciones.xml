<?xml version="1.0" encoding="utf-8"?>
<!--
  Comunicaciones (paleta para el sol, como la pantalla de lectura v2). De arriba abajo:
    barra: volver, titulo y conexion con el servidor (verde = hay, roja = no; Comunicaciones alterna los dos iconos)
    franja oscura con el ultimo mensaje del proceso (txtInfo)
    Ruta en el equipo: archivo cargado y Descargar mi ruta (API, reanudable)
    Enviar al servidor: Enviar datos (accion principal), Validar envio, Enviar fotos
    Equipo: buscar actualizacion, configurar servidor, respaldo de fotos
    Carga antigua (SOAP), de respaldo: ciclo, municipio, seccion, division, Traer ruta y Recibir datos
  Se conservan todos los ids que usa Comunicaciones.java (los iconos de los botones ya vienen en el layout).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lec_superficie"
    android:orientation="vertical"
    tools:context="com.gselectroCaqueta.comunicaciones.Comunicaciones">

    <!-- Barra superior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/lec_superficie"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/btnRegresar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_lec_icono"
            android:contentDescription="@string/com_volver"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_nav_back"
            android:tint="@color/lec_texto" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/com_titulo"
            android:textColor="@color/lec_texto"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Conexion con el servidor: los dos iconos ocupan el mismo lugar. -->
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp">

            <ImageView
                android:id="@+id/iconwebserviceon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_lec_tarjeta"
                android:contentDescription="@string/com_red_activa"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_wifi"
                android:tint="@color/lec_exito"
                android:visibility="invisible" />

            <ImageView
                android:id="@+id/iconwebserviceoff"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_lec_tarjeta"
                android:contentDescription="@string/com_red_inactiva"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_warning"
                android:tint="@color/lec_error"
                android:visibility="visible" />
        </FrameLayout>
    </LinearLayout>

    <!-- Ultimo mensaje del proceso -->
    <TextView
        android:id="@+id/txtInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_com_banner"
        android:hint="@string/com_sin_mensajes"
        android:minHeight="44dp"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:text=""
        android:textColor="@color/lec_banner_texto"
        android:textColorHint="@color/lec_tecla_ayuda"
        android:textSize="14sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Ruta en el equipo -->
            <LinearLayout style="@style/ComTarjeta">

                <TextView
                    style="@style/ComTituloSeccion"
                    android:text="@string/com_seccion_ruta" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/lblArchivo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/com_archivo"
                        android:textColor="@color/lec_texto2"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/lblTxtArchivo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFeatureSettings="tnum"
                        android:maxLines="1"
                        android:text="—"
                        android:textColor="@color/lec_texto"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnMiRuta"
                    style="@style/ComBotonLleno"
                    android:background="@drawable/bg_com_oscuro"
                    android:drawableStart="@drawable/ic_com_descargar"
                    android:text="@string/com_mi_ruta" />

                <TextView
                    style="@style/ComDescripcion"
                    android:layout_marginTop="8dp"
                    android:text="@string/com_mi_ruta_desc" />
            </LinearLayout>

            <!-- Enviar al servidor -->
            <LinearLayout style="@style/ComTarjeta">

                <TextView
                    style="@style/ComTituloSeccion"
                    android:text="@string/com_seccion_envio" />

                <Button
                    android:id="@+id/btnEnviarDatos"
                    style="@style/ComBotonLleno"
                    android:drawableStart="@drawable/ic_nav_send"
                    android:text="@string/com_enviar_datos" />

                <TextView
                    style="@style/ComDescripcion"
                    android:layout_marginTop="8dp"
                    android:text="@string/com_enviar_datos_desc" />

                <Button
                    android:id="@+id/btnValidaEnvio"
                    style="@style/ComBotonAccion"
                    android:layout_marginTop="12dp"
                    android:drawableStart="@drawable/ic_com_verificado"
                    android:text="@string/com_valida_envio" />

                <Button
                    android:id="@+id/btnEnviarFotos"
                    style="@style/ComBotonAccion"
                    android:drawableStart="@drawable/ic_nav_camera"
                    android:enabled="false"
                    android:text="@string/com_enviar_fotos" />
            </LinearLayout>

            <!-- Equipo -->
            <LinearLayout style="@style/ComTarjeta">

                <TextView
                    style="@style/ComTituloSeccion"
                    android:text="@string/com_seccion_equipo" />

                <Button
                    android:id="@+id/btnValidarVersion"
                    style="@style/ComBotonAccion"
                    android:drawableStart="@drawable/ic_nav_sync"
                    android:text="@string/com_validar_version" />

                <Button
                    android:id="@+id/btnConfigurarWeb"
                    style="@style/ComBotonAccion"
                    android:drawableStart="@drawable/ic_nav_tune"
                    android:text="@string/com_configurar_web" />

                <Button
                    android:id="@+id/btnBackupFotos"
                    style="@style/ComBotonAccion"
                    android:drawableStart="@drawable/ic_nav_photo_library"
                    android:enabled="false"
                    android:text="@string/com_backup_fotos" />

                <Button
                    android:id="@+id/btnBorrarBackupFotos"
                    style="@style/ComBotonAccion"
                    android:drawableStart="@drawable/ic_lec_borrar"
                    android:enabled="false"
                    android:text="@string/com_borrar_backup" />
            </LinearLayout>

            <!-- Carga antigua (SOAP), de respaldo -->
            <LinearLayout
                style="@style/ComTarjeta"
                android:background="@drawable/bg_com_soap">

                <TextView
                    style="@style/ComTituloSeccion"
                    android:text="@string/com_seccion_soap" />

                <TextView
                    style="@style/ComDescripcion"
                    android:text="@string/com_soap_desc" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/lblCiclo"
                            style="@style/ComEtiquetaCampo"
                            android:labelFor="@+id/txtCiclo"
                            android:text="@string/com_ciclo" />

                        <EditText
                            android:id="@+id/txtCiclo"
                            style="@style/ComCampo"
                            android:inputType="text"
                            android:maxLength="4"
                            android:text="0000" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/lblMunicipio"
                            style="@style/ComEtiquetaCampo"
                            android:labelFor="@+id/txtMunicipio"
                            android:text="@string/com_municipio" />

                        <EditText
                            android:id="@+id/txtMunicipio"
                            style="@style/ComCampo"
                            android:inputType="number"
                            android:maxLength="4"
                            android:text="0000" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/lblSeccion"
                            style="@style/ComEtiquetaCampo"
                            android:labelFor="@+id/txtSeccion"
                            android:text="@string/com_seccion" />

                        <EditText
                            android:id="@+id/txtSeccion"
                            style="@style/ComCampo"
                            android:inputType="number"
                            android:maxLength="3"
                            android:text="000" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/lblDivision"
                            style="@style/ComEtiquetaCampo"
                            android:labelFor="@+id/txtDivision"
                            android:text="@string/com_division" />

                        <EditText
                            android:id="@+id/txtDivision"
                            style="@style/ComCampo"
                            android:inputType="number"
                            android:maxLength="1"
                            android:text="0" />
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/btnTraerRuta"
                    style="@style/ComBotonAccion"
                    android:layout_marginTop="12dp"
                    android:drawableStart="@drawable/ic_nav_map"
                    android:text="@string/com_traer_ruta" />

                <Button
                    android:id="@+id/btnRecibirDatos"
                    style="@style/ComBotonAccion"
                    android:drawableStart="@drawable/ic_com_descargar"
                    android:text="@string/com_recibir_datos" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</LinearLayout>
