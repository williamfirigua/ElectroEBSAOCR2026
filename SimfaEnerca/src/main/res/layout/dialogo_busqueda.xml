<?xml version="1.0" encoding="utf-8"?>
<!-- Busqueda unica (modulobusquedacuenta.DialogoBusqueda): medidor, cuenta, nombre o direccion. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="20dp">

    <EditText
        android:id="@+id/txtBusquedaUnica"
        style="@style/CauCampo"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:drawableStart="@drawable/ic_lec_buscar"
        android:hint="Medidor, cuenta, nombre o dirección"
        android:imeOptions="actionSearch|flagNoExtractUi"
        android:importantForAutofill="no"
        android:inputType="textNoSuggestions|textCapCharacters"
        android:maxLength="60"
        android:maxLines="1"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/txtEstadoBusqueda"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:textColor="@color/lec_texto2"
        android:textSize="13sp"
        android:textStyle="bold" />

    <ListView
        android:id="@+id/listaBusqueda"
        android:layout_width="match_parent"
        android:layout_height="@dimen/lista_causas_alto"
        android:divider="@null"
        android:dividerHeight="0dp" />
</LinearLayout>
