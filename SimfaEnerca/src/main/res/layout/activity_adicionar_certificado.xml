<?xml version="1.0" encoding="utf-8"?>
<!--
  Entrega certificada (ModuloAdicionarCertificado) con la paleta de sol de la lectura v2: resumen de la factura
  (solo lectura), datos del usuario, campos obligatorios marcados, tarjeta de firma y Guardar entrega.
  Ids conservados: txtacCliclo, txtacMes, txtacAnio, txtacFecha, txtacHora (TextView); txtacCuenta, txtacUsuario,
  txtacDir, txtacTelefono, txtacRecibe, txtacCedula, txtacLector (EditText, mismos enabled/inputType/maxLength/digits);
  btnacfirma, btnacreotornar (Button). Volver sigue bloqueado: no hay flecha.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lec_superficie"
    android:orientation="vertical"
    tools:context="com.gselectroCaqueta.modulocaptnovedlect.ModuloAdicionarCertificado">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/lec_banner"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="10dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_nav_send"
            android:tint="@color/lec_banner_texto" />

        <TextView
            style="@style/lex_Titulo"
            android:text="Entrega certificada"
            android:textColor="@color/lec_banner_texto" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/lec_aviso_cont"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:text="Esta factura va por correo certificado. Complete los datos de quien recibe para seguir con la ruta."
        android:textColor="@color/lec_aviso_texto"
        android:textSize="14sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <!-- Resumen de la factura (solo lectura) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_cau_elegida"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/lex_DatoEtiqueta"
                            android:text="Ciclo" />

                        <TextView
                            android:id="@+id/txtacCliclo"
                            style="@style/lex_DatoValor"
                            android:maxLength="4" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/lex_DatoEtiqueta"
                            android:text="Mes" />

                        <TextView
                            android:id="@+id/txtacMes"
                            style="@style/lex_DatoValor"
                            android:maxLength="2" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/lex_DatoEtiqueta"
                            android:text="Año" />

                        <TextView
                            android:id="@+id/txtacAnio"
                            style="@style/lex_DatoValor"
                            android:maxLength="4" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/lex_DatoEtiqueta"
                            android:text="Fecha" />

                        <TextView
                            android:id="@+id/txtacFecha"
                            style="@style/lex_DatoValor"
                            android:maxLength="10" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/lex_DatoEtiqueta"
                            android:text="Hora" />

                        <TextView
                            android:id="@+id/txtacHora"
                            style="@style/lex_DatoValor"
                            android:maxLength="8" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/lex_DatoEtiqueta"
                            android:text="Cuenta" />

                        <!-- Deshabilitado salvo cuando se abre desde el menu principal (el Java lo habilita). -->
                        <EditText
                            android:id="@+id/txtacCuenta"
                            style="@style/lex_DatoValor"
                            android:layout_height="wrap_content"
                            android:background="@drawable/lex_campo"
                            android:enabled="false"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:maxLength="9"
                            android:minHeight="28dp"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:privateImeOptions="nm"
                            android:textColor="@color/lec_texto" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/lex_txtErrorCuenta"
                style="@style/lex_Error"
                android:text="Falta el número de cuenta." />

            <!-- Datos del usuario -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:minHeight="40dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="78dp"
                    android:layout_height="wrap_content"
                    android:text="Usuario"
                    android:textColor="@color/lec_texto2"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/txtacUsuario"
                    style="@style/lex_Campo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:inputType="text"
                    android:maxLength="48"
                    android:minHeight="40dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/lec_divisor" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:minHeight="40dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="78dp"
                    android:layout_height="wrap_content"
                    android:text="Dirección"
                    android:textColor="@color/lec_texto2"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/txtacDir"
                    style="@style/lex_Campo"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ1234567890 "
                    android:inputType="text"
                    android:maxLength="68"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:minHeight="40dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="78dp"
                    android:layout_height="wrap_content"
                    android:text="CC"
                    android:textColor="@color/lec_texto2"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/txtacCedula"
                    style="@style/lex_Campo"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:fontFeatureSettings="tnum"
                    android:inputType="number"
                    android:maxLength="13"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:minHeight="40dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="78dp"
                    android:layout_height="wrap_content"
                    android:text="Lector"
                    android:textColor="@color/lec_texto2"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/txtacLector"
                    style="@style/lex_Campo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:fontFeatureSettings="tnum"
                    android:inputType="number"
                    android:maxLength="10"
                    android:minHeight="40dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/lec_divisor" />

            <!-- Quien recibe (obligatorios) -->
            <TextView
                style="@style/lex_Etiqueta"
                android:layout_marginTop="12dp"
                android:labelFor="@id/txtacTelefono"
                android:text="Teléfono (obligatorio)" />

            <EditText
                android:id="@+id/txtacTelefono"
                style="@style/lex_Campo"
                android:fontFeatureSettings="tnum"
                android:hint="Celular o fijo"
                android:inputType="phone"
                android:maxLength="20" />

            <TextView
                android:id="@+id/lex_txtErrorTel"
                style="@style/lex_Error"
                android:text="Escriba el teléfono de quien recibe." />

            <TextView
                style="@style/lex_Etiqueta"
                android:layout_marginTop="10dp"
                android:labelFor="@id/txtacRecibe"
                android:text="Quién recibe (obligatorio)" />

            <EditText
                android:id="@+id/txtacRecibe"
                style="@style/lex_Campo"
                android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ1234567890 "
                android:hint="Nombre de quien recibe"
                android:inputType="text"
                android:maxLength="30" />

            <TextView
                android:id="@+id/lex_txtErrorRecibe"
                style="@style/lex_Error"
                android:text="Escriba el nombre de quien recibe." />

            <!-- Firma -->
            <TextView
                style="@style/lex_Etiqueta"
                android:layout_marginTop="12dp"
                android:text="Firma de quien recibe (obligatoria)" />

            <LinearLayout
                android:id="@+id/lex_tarjetaFirma"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/lex_tarjeta"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <ImageView
                    android:id="@+id/lex_imgFirma"
                    android:layout_width="120dp"
                    android:layout_height="56dp"
                    android:background="@drawable/lex_miniatura_firma"
                    android:contentDescription="Vista previa de la firma"
                    android:scaleType="fitCenter"
                    android:src="@drawable/lex_ic_lapiz"
                    android:tint="@color/lec_divisor"
                    android:padding="14dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/lex_txtEstadoFirma"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Sin firma"
                        android:textColor="@color/lec_texto"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnacfirma"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_lec_accion"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:stateListAnimator="@null"
                        android:text="Tomar firma"
                        android:textAllCaps="false"
                        android:textColor="@color/lec_primario"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/lec_divisor" />

    <Button
        android:id="@+id/btnacreotornar"
        style="@style/lex_BotonPrimario"
        android:layout_width="match_parent"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:text="Guardar entrega" />
</LinearLayout>
