<?xml version="1.0" encoding="utf-8"?>
<!--
  Firma (ModuloFirma) con la paleta de sol de la lectura v2: lienzo grande con linea guia, Lapiz / Borrador como
  control segmentado, Borrar todo en rojo y Guardar firma.
  Ids conservados: reloutmf (RelativeLayout donde el Java agrega el lienzo), lblmfCuenta, btnmfErase, btnmfDraw,
  btnmfDelete, btnmfSave (todos Button).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lec_superficie"
    android:orientation="vertical"
    tools:context="com.gselectroCaqueta.modulocaptnovedlect.ModuloFirma">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            style="@style/lex_Titulo"
            android:text="Firma de quien recibe" />

        <TextView
            android:id="@+id/lblmfCuenta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFeatureSettings="tnum"
            android:text="Cuenta: "
            android:textColor="@color/lec_texto2"
            android:textSize="14sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/lec_divisor" />

    <LinearLayout
        android:layout_width="240dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/lex_segmentado"
        android:orientation="horizontal"
        android:padding="2dp">

        <Button
            android:id="@+id/btnmfDraw"
            style="@style/lex_Segmento"
            android:drawableStart="@drawable/lex_ic_lapiz"
            android:drawablePadding="6dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Lápiz"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnmfErase"
            style="@style/lex_Segmento"
            android:drawableStart="@drawable/lex_ic_borrador"
            android:drawablePadding="6dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Borrador"
            android:textSize="15sp" />
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/reloutmf"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:layout_weight="1"
        android:background="@drawable/bg_lec_tarjeta"
        android:minHeight="220dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="10dp"
            android:text="Firme aquí, sobre la línea"
            android:textColor="@color/lec_texto2"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lex_marcaX"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@id/lex_lineaFirma"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="2dp"
            android:importantForAccessibility="no"
            android:text="✕"
            android:textColor="@color/lec_texto2"
            android:textSize="16sp"
            android:textStyle="bold" />

        <View
            android:id="@+id/lex_lineaFirma"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="44dp"
            android:background="@drawable/lex_linea_firma"
            android:layerType="software" />
    </RelativeLayout>

    <TextView
        android:id="@+id/lex_txtErrorFirma"
        style="@style/lex_Error"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:text="Falta la firma: firme dentro del recuadro." />

    <TextView
        style="@style/lex_Ayuda"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:text="Lápiz para firmar, Borrador para corregir un trazo." />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnmfDelete"
            style="@style/lex_BotonPeligro"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:drawableStart="@drawable/lex_ic_papelera"
            android:drawablePadding="4dp"
            android:drawableTint="@color/lec_error"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Borrar todo" />

        <Button
            android:id="@+id/btnmfSave"
            style="@style/lex_BotonPrimario"
            android:layout_width="0dp"
            android:layout_marginStart="8dp"
            android:layout_weight="2"
            android:text="Guardar firma" />
    </LinearLayout>
</LinearLayout>
