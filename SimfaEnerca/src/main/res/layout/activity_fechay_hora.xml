<?xml version="1.0" encoding="utf-8"?>
<!--
  Diagnostico del equipo (FechayHora), paleta para el sol de colors_lectura. De arriba abajo:
    barra: volver (btnRegresarfecha) y titulo
    tarjeta oscura con la hora grande (hk_time) y la fecha
    Estado: cuatro casillas que NO se tocan (tGps, tMavion, tRed, tBateria siguen siendo ToggleButton
      deshabilitados; el texto y el marcado los pone FechayHora; el fondo cambia con el marcado)
    Servidor: direccion activa (txvIp), segunda linea (txvIp2), Probar conexion (btnPruebaWs) y su resultado
    Impresora: MAC (txtMac)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lec_superficie"
    android:orientation="vertical"
    tools:context="com.gselectroCaqueta.accesoyseguridad.FechayHora">

    <!-- Barra superior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/lec_superficie"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/btnRegresarfecha"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_lec_icono"
            android:contentDescription="Volver"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_nav_back"
            android:tint="@color/lec_texto" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Diagnóstico del equipo"
            android:textColor="@color/lec_texto"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/lec_divisor" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <!-- Hora del sistema -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/sis_bg_reloj"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp">

                <android.widget.TextClock
                    android:id="@+id/hk_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:format12Hour="h:mm:ss a"
                    android:format24Hour="HH:mm:ss"
                    android:textColor="@color/lec_banner_texto"
                    android:textSize="44sp"
                    android:textStyle="bold" />

                <android.widget.TextClock
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:format12Hour="EEEE, d 'de' MMMM 'de' yyyy"
                    android:format24Hour="EEEE, d 'de' MMMM 'de' yyyy"
                    android:textColor="@color/lec_banner_texto"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Estado del equipo: solo indicadores, no responden al toque -->
            <TextView
                style="@style/ComTituloSeccion"
                android:layout_marginTop="16dp"
                android:text="Estado" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1">

                    <ToggleButton
                        android:id="@+id/tGps"
                        style="@style/SisEstado"
                        android:background="@drawable/sis_bg_estado"
                        android:drawableStart="@drawable/sis_punto_estado" />

                    <TextView
                        style="@style/SisEstadoEtiqueta"
                        android:text="GPS" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1">

                    <!-- Modo avion: marcado (encendido) es lo que hay que revisar, por eso el fondo va al reves. -->
                    <ToggleButton
                        android:id="@+id/tMavion"
                        style="@style/SisEstado"
                        android:background="@drawable/sis_bg_estado_inv"
                        android:drawableStart="@drawable/sis_punto_estado_inv" />

                    <TextView
                        style="@style/SisEstadoEtiqueta"
                        android:text="Modo avión" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1">

                    <ToggleButton
                        android:id="@+id/tRed"
                        style="@style/SisEstado"
                        android:background="@drawable/sis_bg_estado"
                        android:drawableStart="@drawable/sis_punto_estado" />

                    <TextView
                        style="@style/SisEstadoEtiqueta"
                        android:text="Red" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1">

                    <ToggleButton
                        android:id="@+id/tBateria"
                        style="@style/SisEstado"
                        android:background="@drawable/sis_bg_estado"
                        android:drawableStart="@drawable/sis_punto_estado" />

                    <TextView
                        style="@style/SisEstadoEtiqueta"
                        android:text="Batería" />
                </FrameLayout>
            </LinearLayout>

            <!-- Servidor -->
            <LinearLayout
                style="@style/ComTarjeta"
                android:layout_marginTop="16dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <TextView
                    style="@style/ComTituloSeccion"
                    android:drawableStart="@drawable/ic_nav_wifi"
                    android:drawablePadding="8dp"
                    android:drawableTint="@color/lec_primario"
                    android:gravity="center_vertical"
                    android:text="Servidor" />

                <TextView
                    style="@style/ComEtiquetaCampo"
                    android:layout_marginTop="10dp"
                    android:text="Dirección" />

                <TextView
                    android:id="@+id/txvIp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:breakStrategy="simple"
                    android:fontFeatureSettings="tnum"
                    android:text="Sin dirección configurada"
                    android:textColor="@color/lec_texto"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/txvIp2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@color/lec_texto2"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnPruebaWs"
                    style="@style/ComBotonLleno"
                    android:layout_marginTop="12dp"
                    android:drawableStart="@drawable/ic_nav_sync"
                    android:text="Probar conexión" />

                <!-- Resultado de Probar conexion (lo llena FechayHora; tambien queda el Toast). -->
                <TextView
                    android:id="@+id/sis_resultado_ws"
                    style="@style/SisResultado"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Impresora -->
            <LinearLayout
                style="@style/ComTarjeta"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_nav_print"
                    android:tint="@color/lec_primario" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/ComTituloSeccion"
                        android:text="Impresora" />

                    <TextView
                        android:id="@+id/txtMac"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:text="Sin impresora registrada"
                        android:textColor="@color/lec_texto2"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
