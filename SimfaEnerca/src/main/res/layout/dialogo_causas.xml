<?xml version="1.0" encoding="utf-8"?>
<!-- Contenido del dialogo de causas de no lectura (moduloanomalias.DialogoCausas). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="20dp">

    <EditText
        android:id="@+id/txtBuscarCausa"
        style="@style/CauCampo"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:drawableStart="@drawable/ic_lec_buscar"
        android:hint="Código o descripción"
        android:imeOptions="actionDone|flagNoExtractUi"
        android:importantForAutofill="no"
        android:inputType="textNoSuggestions|textCapCharacters"
        android:maxLines="1"
        android:textSize="16sp" />

    <ListView
        android:id="@+id/listaCausas"
        android:layout_width="match_parent"
        android:layout_height="@dimen/lista_causas_alto"
        android:layout_marginTop="8dp"
        android:choiceMode="singleChoice"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:fastScrollEnabled="true"
        android:listSelector="@android:color/transparent" />

    <TextView
        android:id="@+id/txtCausaElegida"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_cau_elegida"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:text="Toque una causa o digite el código"
        android:textColor="@color/lec_texto"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
