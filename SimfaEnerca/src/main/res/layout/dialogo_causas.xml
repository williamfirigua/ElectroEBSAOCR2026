<?xml version="1.0" encoding="utf-8"?>
<!-- Contenido del dialogo de causas de no lectura (moduloanomalias.DialogoCausas). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp">

    <EditText
        android:id="@+id/txtBuscarCausa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Código o descripción"
        android:imeOptions="actionDone|flagNoExtractUi"
        android:importantForAutofill="no"
        android:inputType="textNoSuggestions|textCapCharacters"
        android:maxLines="1"
        android:textSize="18sp" />

    <ListView
        android:id="@+id/listaCausas"
        android:layout_width="match_parent"
        android:layout_height="@dimen/lista_causas_alto"
        android:layout_marginTop="4dp"
        android:choiceMode="singleChoice"
        android:divider="#FFD5DAE8"
        android:dividerHeight="1dp"
        android:fastScrollEnabled="true" />

    <TextView
        android:id="@+id/txtCausaElegida"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@color/grayBlueSoft"
        android:minHeight="40dp"
        android:padding="8dp"
        android:text="Toque una causa o digite el código"
        android:textColor="@color/bluePopHard"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
