<?xml version="1.0" encoding="utf-8"?>
<!-- Comunicaciones: Descargar mi ruta. Azul oscuro lleno (el color de las teclas de la lectura). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#55FFFFFF">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <solid android:color="@color/lec_contenedor" />
                    <stroke android:width="2dp" android:color="@color/lec_borde" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/lec_tecla" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
