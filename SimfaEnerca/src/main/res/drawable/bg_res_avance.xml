<?xml version="1.0" encoding="utf-8"?>
<!-- Resumen: barra de avance. Fondo azul claro con borde oscuro, avance azul primario. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/lec_primario_cont" />
            <stroke android:width="2dp" android:color="@color/lec_contorno" />
            <corners android:radius="7dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/lec_primario" />
                <corners android:radius="7dp" />
            </shape>
        </clip>
    </item>
</layer-list>
