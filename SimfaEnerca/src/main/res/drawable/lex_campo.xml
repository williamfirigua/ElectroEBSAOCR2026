<?xml version="1.0" encoding="utf-8"?>
<!-- Campo de texto: blanco con borde negro de 2dp; deshabilitado (solo lectura) sin borde, como texto. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#00FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/lec_superficie" />
            <stroke android:width="2dp" android:color="@color/lec_texto" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
