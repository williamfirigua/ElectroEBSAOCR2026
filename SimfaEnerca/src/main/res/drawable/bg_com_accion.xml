<?xml version="1.0" encoding="utf-8"?>
<!-- Comunicaciones: tarjeta de accion (icono + titulo + una linea). Blanca con borde oscuro de 2dp;
     deshabilitada, gris claro con borde gris para que se note que no responde. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33000000">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <solid android:color="@color/lec_contenedor" />
                    <stroke android:width="2dp" android:color="@color/lec_divisor" android:dashWidth="6dp" android:dashGap="4dp" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/lec_superficie" />
                    <stroke android:width="2dp" android:color="@color/lec_contorno" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
