<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de resultado (busqueda, galeria, subcausales): blanca con linea divisoria oscura abajo. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33000000">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/lec_divisor" />
                </shape>
            </item>
            <item android:bottom="1.5dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/lec_superficie" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
