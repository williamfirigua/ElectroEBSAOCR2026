<?xml version="1.0" encoding="utf-8"?>
<!-- Boton secundario de los dialogos (Cancelar, Cerrar): blanco con borde oscuro de 2dp. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33000000">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/lec_superficie" />
            <stroke android:width="2dp" android:color="@color/lec_contorno" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</ripple>
