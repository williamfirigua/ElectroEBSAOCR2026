<?xml version="1.0" encoding="utf-8"?>
<!-- Encabezado de la tabla de pendientes: gris claro con linea oscura de 2dp abajo. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/lec_contorno" />
        </shape>
    </item>
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/lec_contenedor" />
        </shape>
    </item>
</layer-list>
