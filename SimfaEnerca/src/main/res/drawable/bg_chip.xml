<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- SELECCIONADO -->
    <item android:state_checked="true">
        <shape>
            <solid android:color="#1976D2"/>
            <corners android:radius="20dp"/>
            <stroke
                android:width="1dp"
                android:color="#1565C0"/>
            <padding
                android:left="12dp"
                android:right="12dp"
                android:top="6dp"
                android:bottom="6dp"/>
        </shape>
    </item>

    <!-- PRESIONADO -->
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#BBDEFB"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>

    <!-- NORMAL -->
    <item>
        <shape>
            <solid android:color="#E0E0E0"/>
            <corners android:radius="20dp"/>
            <stroke
                android:width="1dp"
                android:color="#BDBDBD"/>
            <padding
                android:left="12dp"
                android:right="12dp"
                android:top="6dp"
                android:bottom="6dp"/>
        </shape>
    </item>

</selector>