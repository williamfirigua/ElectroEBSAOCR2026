<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de causal: linea divisoria abajo; la elegida queda en azul claro con borde azul de 2dp. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33000000">
    <item>
        <selector>
            <item android:state_activated="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/lec_primario_cont" />
                    <stroke android:width="2dp" android:color="@color/lec_primario" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item>
                <layer-list>
                    <item>
                        <shape android:shape="rectangle">
                            <solid android:color="@color/lec_divisor" />
                        </shape>
                    </item>
                    <item android:bottom="1.5dp">
                        <shape android:shape="rectangle">
                            <solid android:color="@color/lec_superficie" />
                        </shape>
                    </item>
                </layer-list>
            </item>
        </selector>
    </item>
</ripple>
