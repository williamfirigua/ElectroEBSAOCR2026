<?xml version="1.0" encoding="utf-8"?>
<!-- Fila que exige atencion del lector (anomalia, GPS/OCR obligatorio, observacion anterior). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#FFFFF4E5" />
        </shape>
    </item>
    <item android:gravity="start" android:width="4dp">
        <shape>
            <solid android:color="#FFE0A025" />
        </shape>
    </item>
    <item android:gravity="bottom">
        <shape>
            <size android:height="1dp" />
            <solid android:color="#FFD5DAE8" />
        </shape>
    </item>
</layer-list>
