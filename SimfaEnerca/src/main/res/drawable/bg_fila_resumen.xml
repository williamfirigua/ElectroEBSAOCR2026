<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de la lista del resumen: blanca, azul claro al tocarla o seleccionarla. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape>
            <solid android:color="#FFE3F2FD" />
            <corners android:radius="10dp" />
            <stroke android:width="2dp" android:color="#FF1565C0" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#FFEEF2F7" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#FFE0E4EC" />
        </shape>
    </item>
</selector>
