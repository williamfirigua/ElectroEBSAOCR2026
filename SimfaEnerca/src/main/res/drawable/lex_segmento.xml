<?xml version="1.0" encoding="utf-8"?>
<!-- Opcion de un control segmentado (dentro de lex_segmentado): la marcada (checked o activated) va azul llena, la otra transparente. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33000000">
    <item>
        <selector>
            <item android:state_checked="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/lec_primario" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item android:state_activated="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/lec_primario" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#00FFFFFF" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
