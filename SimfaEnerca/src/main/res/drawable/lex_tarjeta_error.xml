<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta de firma cuando falta la firma al guardar: borde rojo de 2dp. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33000000">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFE1E1" />
            <stroke android:width="2dp" android:color="@color/lec_error" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</ripple>
