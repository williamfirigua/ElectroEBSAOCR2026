<?xml version="1.0" encoding="utf-8"?>
<!-- Segmento derecho: azul lleno cuando esta marcado. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33000000">
    <item>
        <selector>
            <item android:state_checked="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/lec_primario" />
                    <corners android:topLeftRadius="0dp" android:bottomLeftRadius="0dp"
                        android:topRightRadius="10dp" android:bottomRightRadius="10dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/lec_superficie" />
                    <corners android:topLeftRadius="0dp" android:bottomLeftRadius="0dp"
                        android:topRightRadius="10dp" android:bottomRightRadius="10dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
