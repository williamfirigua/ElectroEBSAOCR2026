<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de la tabla de pendientes: blanca con linea divisoria de 1dp abajo. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/lec_divisor" />
        </shape>
    </item>
    <item android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/lec_superficie" />
        </shape>
    </item>
</layer-list>
