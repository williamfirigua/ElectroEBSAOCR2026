    <!--
requerido desde android 11 api 30+ packege visibility filtering
sin este bloque, packemanager.getApplicationInfo() leanza
nameNotFoundException para cualquier app externa, aunque este instalada.
Esto hacia que NavigationHelper cayera siempre al fallcack in app.
-->
    <queries>
        <!-- Google Maps — navegación turn-by-turn -->
        <package android:name="com.google.android.apps.maps" />
        <!-- Waze -->
        <package android:name="com.waze" />
        <!-- Fallback: cualquier app que maneje URIs de navegación -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="google.navigation" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="waze" />
        </intent>
    </queries>
    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher1"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:exported="true"
        android:usesCleartextTraffic="true"
        android:requestLegacyExternalStorage="true"
